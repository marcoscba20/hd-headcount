/// Eje de tiempo MAESTRO, deliberadamente DESCONECTADO del modelo. Define el período de análisis (rango) que leen las medidas point-in-time: HC Activo Inicio/Fin/PIT, Altas, Bajas y todas las tasas de rotación. NO relacionar con ninguna tabla: si se relaciona, esas medidas se filtran dos veces y devuelven números incorrectos. Para cortar por fecha de ingreso usar 'Calendario Ingreso'; por fecha de baja, 'Calendario Baja'. Arranca en 2025-01 porque el export no tiene bajas anteriores.
table Calendario
	lineageTag: ce552f0e-eef8-4118-88bd-3a8a1bd3a08a
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: 7c4e6e92-73a4-4e2c-a896-b2f0dc4a69c2
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Año
		dataType: int64
		lineageTag: 838ce1e8-4088-4038-8bca-195818cd9ee3
		summarizeBy: none
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column 'Nº Mes'
		dataType: int64
		lineageTag: 1f8bb915-53c7-4a0a-9784-313727bed6ed
		summarizeBy: none
		sourceColumn: [Nº Mes]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: 9445c0ea-6487-4371-8b92-3ba97921f2ed
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: 'Nº Mes'

		annotation SummarizationSetBy = Automatic

	column Año-Mes
		dataType: string
		lineageTag: ad470c4c-077f-41f3-b719-73f06c6af42d
		summarizeBy: none
		sourceColumn: [Año-Mes]
		sortByColumn: 'Año-Mes Orden'

		annotation SummarizationSetBy = Automatic

	column 'Nº Trimestre'
		dataType: int64
		lineageTag: 38d6e65d-6f64-4590-8540-994150b1799b
		summarizeBy: none
		sourceColumn: [Nº Trimestre]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: 4efa8726-fcf1-4e10-86f3-282dcebc5d9e
		summarizeBy: none
		sourceColumn: [Trimestre]
		sortByColumn: 'Nº Trimestre'

		annotation SummarizationSetBy = Automatic

	column Año-Trimestre
		dataType: string
		lineageTag: 966fd915-4303-40dc-8172-14c71c46a221
		summarizeBy: none
		sourceColumn: [Año-Trimestre]

		annotation SummarizationSetBy = Automatic

	column Semestre
		dataType: string
		lineageTag: c99ef30e-b23d-47ee-bae8-0ad72fdb2ecb
		summarizeBy: none
		sourceColumn: [Semestre]

		annotation SummarizationSetBy = Automatic

	column Año-Semestre
		dataType: string
		lineageTag: da044e53-d943-488d-8ee7-260e1ae1db5c
		summarizeBy: none
		sourceColumn: [Año-Semestre]

		annotation SummarizationSetBy = Automatic

	column 'Año-Mes Orden'
		dataType: int64
		lineageTag: b48f2a71-9c05-4e36-8d17-52c6039be4a8
		summarizeBy: none
		sourceColumn: [Año-Mes Orden]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2025, 1, 1), EOMONTH(TODAY(), 0)),
				    "Año", YEAR([Date]),
				    "Nº Mes", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMM"),
				    "Año-Mes", FORMAT([Date], "yyyy-MM"),
				    "Año-Mes Orden", YEAR([Date]) * 100 + MONTH([Date]),
				    "Nº Trimestre", ROUNDUP(MONTH([Date]) / 3, 0),
				    "Trimestre", "T" & ROUNDUP(MONTH([Date]) / 3, 0),
				    "Año-Trimestre", FORMAT([Date], "yyyy") & "-T" & ROUNDUP(MONTH([Date]) / 3, 0),
				    "Semestre", "S" & ROUNDUP(MONTH([Date]) / 6, 0),
				    "Año-Semestre", FORMAT([Date], "yyyy") & "-S" & ROUNDUP(MONTH([Date]) / 6, 0)
				)

	annotation PBI_Id = Calendario

