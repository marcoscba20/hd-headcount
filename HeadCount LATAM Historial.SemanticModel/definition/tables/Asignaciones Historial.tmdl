	/// Effective End Date ajustada: si la versión siguiente es la baja, termina el día anterior (la persona deja de contar el día de su Termination Date, igual que en [HC Activo Fin]).
	column 'Fin Vigencia HC'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 24a1d3a1-6a52-4ebd-8ea9-e40e30521fe1
		summarizeBy: none
		sourceColumn: Fin Vigencia HC

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Fecha del evento de la versión: Effective Start Date, salvo bajas (Start - 1 = último día trabajado = Termination Date).
	column 'Fecha Evento'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 4973bc20-db33-4590-af7f-9624bd3568fe
		summarizeBy: none
		sourceColumn: Fecha Evento

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Sí = asignación con Termination Date pero sin evento Terminate (pending worker o asignación administrativa abierta y cerrada casi en el día). No es alta ni baja real.
	column 'Asignación Efímera'
		dataType: string
		lineageTag: 2b222b59-293e-4abe-b5ae-8b5bc3fd1645
		summarizeBy: none
		sourceColumn: Asignación Efímera

		annotation SummarizationSetBy = Automatic

	/// Alta / Baja / Promoción / Cambio de puesto / Cambio de manager / Otro (sincronizaciones de posición, pending workers, efímeras).
	column 'Tipo Evento'
		dataType: string
		lineageTag: c723c469-e794-4447-be81-a139e15babc8
		summarizeBy: none
		sourceColumn: Tipo Evento

		annotation SummarizationSetBy = Automatic

	/// Assignment Number | Fecha Evento | Tipo Evento. Deduplica eventos repetidos el mismo día.
	column 'Clave Evento'
		dataType: string
		lineageTag: 75334b32-1fe9-4f85-b517-cb6dc40fcd15
		summarizeBy: none
		sourceColumn: Clave Evento

		annotation SummarizationSetBy = Automatic

	/// Nivel a la fecha de la versión ("L1".."L9" / "Sin Nivel"). Misma regla que Asignaciones[Nivel].
	column Nivel =
			VAR L = 'Asignaciones Historial'[Level]
			RETURN
			    IF ( L IN { "0", "", "Sin Datos" } || ISBLANK ( L ), "Sin Nivel", "L" & L )
		dataType: string
		lineageTag: bf494556-e880-4a6d-b6d4-88d217822114
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Agrupación de Grade a la fecha de la versión. Misma regla que Asignaciones[Grade Grupo].
	column 'Grade Grupo' =
			SWITCH (
			    TRUE (),
			    'Asignaciones Historial'[Grade Nº] = 99, "Sin Grade",
			    'Asignaciones Historial'[Grade Nº] >= 8, "G8+",
			    "G1-G7"
			)
		dataType: string
		lineageTag: 259c0948-54e5-446f-b592-160d669eb642
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Esquema MBO a la fecha de la versión. Misma regla que Asignaciones[Esquema MBO].
	column 'Esquema MBO' =
			SWITCH (
			    'Asignaciones Historial'[MBO Bonus Scheme],
			    "Yes", "Con MBO",
			    "No", "Sin MBO",
			    "No Aplica"
			)
		dataType: string
		lineageTag: 4572a223-d1ac-4dff-a86e-0c6e034bf0d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Asignaciones Historial' = m
		mode: import
		source =
				let
				    Tipos = Table.TransformColumnTypes(#"Fuente Historial Asignaciones", {{"Assignment Number", type text}, {"Primary Assignment Flag", type text}, {"Effective Start Date", type date}, {"Effective End Date", type date}, {"Effective Sequence", Int64.Type}, {"Effective Latest Change", type text}, {"Action Code", type text}, {"Action Type", type text}, {"Action Reason Code", type text}, {"Assignment Status", type text}, {"Assignment Status Type", type text}, {"Hire Date", type date}, {"Original Hire Date", type date}, {"Tipo de baja", type text}, {"Rehire Recommendation", type text}, {"Legal Employer Code", type text}, {"Job", type text}, {"Job Code", type text}, {"Location", type text}, {"Grade Code", type text}}),
				    SinVacias = Table.RemoveColumns(Tipos, {"Management Level"}, MissingField.Ignore),
				    Limpia = #"Limpiar HC"(SinVacias),
				
				    // Bajas: la versión Terminate arranca el día siguiente a la Termination Date
				    FilasBaja = Table.SelectRows(Limpia, each [Action Type] = "Terminate Work Relationship"),
				    ClavesBaja = List.Buffer(List.Transform(Table.ToRecords(FilasBaja), each [Assignment Number] & "|" & Text.From(Number.From([Effective Start Date])))),
				    AsigConBaja = List.Buffer(List.Distinct(FilasBaja[Assignment Number])),
				    TiposAlta = {"Hire an Employee", "Rehire an Employee", "Add Contingent Worker"},
				
				    #"Fin Vigencia" = Table.AddColumn(Limpia, "Fin Vigencia HC", each if List.Contains(ClavesBaja, [Assignment Number] & "|" & Text.From(Number.From([Effective End Date]) + 1)) then Date.AddDays([Effective End Date], -1) else [Effective End Date], type date),
				    #"Fecha Evento" = Table.AddColumn(#"Fin Vigencia", "Fecha Evento", each if [Action Type] = "Terminate Work Relationship" then Date.AddDays([Effective Start Date], -1) else [Effective Start Date], type date),
				    // Efímera: cerrada (Termination Date real) sin evento Terminate -> no es alta ni baja real
				    Efimera = Table.AddColumn(#"Fecha Evento", "Asignación Efímera", each if [Termination Date] <> #date(1900, 1, 1) and not List.Contains(AsigConBaja, [Assignment Number]) then "Sí" else "No", type text),
				    #"Tipo Evento" = Table.AddColumn(Efimera, "Tipo Evento", each let a = [Action Type] in if a = "Terminate Work Relationship" then "Baja" else if List.Contains(TiposAlta, a) and [Asignación Efímera] = "No" then "Alta" else if a = "Promote" then "Promoción" else if a = "Change Employment" then "Cambio de puesto" else if a = "Change Manager" then "Cambio de manager" else "Otro", type text),
				    #"Clave Evento" = Table.AddColumn(#"Tipo Evento", "Clave Evento", each [Assignment Number] & "|" & Text.From(Number.From([Fecha Evento])) & "|" & [Tipo Evento], type text)
				in
				    #"Clave Evento"

	annotation PBI_ResultType = Table

