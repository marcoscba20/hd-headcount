/// Historial de asignaciones Oracle (SCD2). Una fila por asignación y versión efectiva vigente entre Effective Start Date y Effective End Date (4712-12-31 = vigente hoy). Historia confiable desde 2024-12-31. Medidas: carpeta '11 · Historial (PIT)'; controles: '12 · Validación Historial'.
table 'Asignaciones Historial'
	lineageTag: 791b6432-7b46-4a67-966d-e130d9174711

	/// Personas con asignación activa al último día del período, según la versión efectiva de Oracle a esa fecha. Respeta los slicers de 'Dim Persona' y Asignaciones aplicándolos a los atributos vigentes en cada fecha.
	measure 'HC Hist Fin' =
			VAR D = MAX ( 'Calendario'[Date] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Asignaciones Historial'[Person Number] ),
			    'Asignaciones Historial'[Effective Latest Change] = "Yes",
			    'Asignaciones Historial'[Effective Start Date] <= D,
			    'Asignaciones Historial'[Fin Vigencia HC] >= D,
			    'Asignaciones Historial'[Assignment Status Type] = "Active",
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[País Overview] ), ( NOT ISFILTERED ( 'Dim Persona'[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( 'Dim Persona'[País Overview] ) ) && ( NOT ISFILTERED ( Asignaciones[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( Asignaciones[País Overview] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Country] ), ( NOT ISFILTERED ( 'Dim Persona'[País] ) || 'Asignaciones Historial'[Country] IN FILTERS ( 'Dim Persona'[País] ) ) && ( NOT ISFILTERED ( Asignaciones[Country] ) || 'Asignaciones Historial'[Country] IN FILTERS ( Asignaciones[Country] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Legal Employer Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Entidad Legal] ) || 'Asignaciones Historial'[Legal Employer Name] IN FILTERS ( 'Dim Persona'[Entidad Legal] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Ámbito] ), ( NOT ISFILTERED ( 'Dim Persona'[Ámbito] ) || 'Asignaciones Historial'[Ámbito] IN FILTERS ( 'Dim Persona'[Ámbito] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Cross Charge Entity Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( 'Dim Persona'[Cross Charge Entity Name] ) ) && ( NOT ISFILTERED ( Asignaciones[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( Asignaciones[Cross Charge Entity Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[EPM Main Function Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Función] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( 'Dim Persona'[Función] ) ) && ( NOT ISFILTERED ( Asignaciones[EPM Main Function Name] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( Asignaciones[EPM Main Function Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Labor Type] ), ( NOT ISFILTERED ( 'Dim Persona'[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( 'Dim Persona'[Labor Type] ) ) && ( NOT ISFILTERED ( Asignaciones[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( Asignaciones[Labor Type] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( 'Dim Persona'[Grade] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Name] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( Asignaciones[Grade Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Grupo] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( 'Dim Persona'[Grade Grupo] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( Asignaciones[Grade Grupo] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Nivel] ), ( NOT ISFILTERED ( 'Dim Persona'[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( 'Dim Persona'[Nivel] ) ) && ( NOT ISFILTERED ( Asignaciones[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( Asignaciones[Nivel] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Esquema MBO] ), ( NOT ISFILTERED ( 'Dim Persona'[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( 'Dim Persona'[Esquema MBO] ) ) && ( NOT ISFILTERED ( Asignaciones[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( Asignaciones[Esquema MBO] ) ) ) )
			)
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: de6a8a91-90ca-4cb5-bb2d-df511ce8c89d

	/// Personas activas el día previo al inicio del período (historial). Respeta los slicers de 'Dim Persona' y Asignaciones aplicándolos a los atributos vigentes en cada fecha.
	measure 'HC Hist Inicio' =
			VAR D = MIN ( 'Calendario'[Date] ) - 1
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Asignaciones Historial'[Person Number] ),
			    'Asignaciones Historial'[Effective Latest Change] = "Yes",
			    'Asignaciones Historial'[Effective Start Date] <= D,
			    'Asignaciones Historial'[Fin Vigencia HC] >= D,
			    'Asignaciones Historial'[Assignment Status Type] = "Active",
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[País Overview] ), ( NOT ISFILTERED ( 'Dim Persona'[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( 'Dim Persona'[País Overview] ) ) && ( NOT ISFILTERED ( Asignaciones[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( Asignaciones[País Overview] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Country] ), ( NOT ISFILTERED ( 'Dim Persona'[País] ) || 'Asignaciones Historial'[Country] IN FILTERS ( 'Dim Persona'[País] ) ) && ( NOT ISFILTERED ( Asignaciones[Country] ) || 'Asignaciones Historial'[Country] IN FILTERS ( Asignaciones[Country] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Legal Employer Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Entidad Legal] ) || 'Asignaciones Historial'[Legal Employer Name] IN FILTERS ( 'Dim Persona'[Entidad Legal] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Ámbito] ), ( NOT ISFILTERED ( 'Dim Persona'[Ámbito] ) || 'Asignaciones Historial'[Ámbito] IN FILTERS ( 'Dim Persona'[Ámbito] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Cross Charge Entity Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( 'Dim Persona'[Cross Charge Entity Name] ) ) && ( NOT ISFILTERED ( Asignaciones[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( Asignaciones[Cross Charge Entity Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[EPM Main Function Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Función] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( 'Dim Persona'[Función] ) ) && ( NOT ISFILTERED ( Asignaciones[EPM Main Function Name] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( Asignaciones[EPM Main Function Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Labor Type] ), ( NOT ISFILTERED ( 'Dim Persona'[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( 'Dim Persona'[Labor Type] ) ) && ( NOT ISFILTERED ( Asignaciones[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( Asignaciones[Labor Type] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( 'Dim Persona'[Grade] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Name] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( Asignaciones[Grade Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Grupo] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( 'Dim Persona'[Grade Grupo] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( Asignaciones[Grade Grupo] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Nivel] ), ( NOT ISFILTERED ( 'Dim Persona'[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( 'Dim Persona'[Nivel] ) ) && ( NOT ISFILTERED ( Asignaciones[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( Asignaciones[Nivel] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Esquema MBO] ), ( NOT ISFILTERED ( 'Dim Persona'[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( 'Dim Persona'[Esquema MBO] ) ) && ( NOT ISFILTERED ( Asignaciones[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( Asignaciones[Esquema MBO] ) ) ) )
			)
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: f8cee8da-c727-4537-a537-001f623ccab9

	/// Promedio inicio/fin del período (historial). Denominador de las tasas de rotación históricas.
	measure 'HC Hist Promedio' = DIVIDE ( [HC Hist Inicio] + [HC Hist Fin], 2 )
		formatString: #,##0.0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 15415bc6-4110-401d-8232-5cae92d8a8c4

	/// HC al cierre de cada mes COMPLETO con atributos de esa fecha (evolución con 'Calendario'[Año-Mes] en el eje). Equivalente histórico de [HC Activo PIT]. Respeta los slicers de 'Dim Persona' y Asignaciones aplicándolos a los atributos vigentes en cada fecha.
	measure 'HC Hist PIT' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR D = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			RETURN
			    IF (
			        MIN ( 'Calendario'[Date] ) <= FinCerrado,
			        CALCULATE (
			            DISTINCTCOUNT ( 'Asignaciones Historial'[Person Number] ),
			            'Asignaciones Historial'[Effective Latest Change] = "Yes",
			            'Asignaciones Historial'[Effective Start Date] <= D,
			            'Asignaciones Historial'[Fin Vigencia HC] >= D,
			            'Asignaciones Historial'[Assignment Status Type] = "Active",
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[País Overview] ), ( NOT ISFILTERED ( 'Dim Persona'[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( 'Dim Persona'[País Overview] ) ) && ( NOT ISFILTERED ( Asignaciones[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( Asignaciones[País Overview] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Country] ), ( NOT ISFILTERED ( 'Dim Persona'[País] ) || 'Asignaciones Historial'[Country] IN FILTERS ( 'Dim Persona'[País] ) ) && ( NOT ISFILTERED ( Asignaciones[Country] ) || 'Asignaciones Historial'[Country] IN FILTERS ( Asignaciones[Country] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Legal Employer Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Entidad Legal] ) || 'Asignaciones Historial'[Legal Employer Name] IN FILTERS ( 'Dim Persona'[Entidad Legal] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Ámbito] ), ( NOT ISFILTERED ( 'Dim Persona'[Ámbito] ) || 'Asignaciones Historial'[Ámbito] IN FILTERS ( 'Dim Persona'[Ámbito] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Cross Charge Entity Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( 'Dim Persona'[Cross Charge Entity Name] ) ) && ( NOT ISFILTERED ( Asignaciones[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( Asignaciones[Cross Charge Entity Name] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[EPM Main Function Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Función] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( 'Dim Persona'[Función] ) ) && ( NOT ISFILTERED ( Asignaciones[EPM Main Function Name] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( Asignaciones[EPM Main Function Name] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Labor Type] ), ( NOT ISFILTERED ( 'Dim Persona'[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( 'Dim Persona'[Labor Type] ) ) && ( NOT ISFILTERED ( Asignaciones[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( Asignaciones[Labor Type] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( 'Dim Persona'[Grade] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Name] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( Asignaciones[Grade Name] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Grupo] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( 'Dim Persona'[Grade Grupo] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( Asignaciones[Grade Grupo] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Nivel] ), ( NOT ISFILTERED ( 'Dim Persona'[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( 'Dim Persona'[Nivel] ) ) && ( NOT ISFILTERED ( Asignaciones[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( Asignaciones[Nivel] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Esquema MBO] ), ( NOT ISFILTERED ( 'Dim Persona'[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( 'Dim Persona'[Esquema MBO] ) ) && ( NOT ISFILTERED ( Asignaciones[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( Asignaciones[Esquema MBO] ) ) ) )
			        )
			    )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 1e75d689-5c72-4218-a79b-19a5507395d9

	/// HC un año antes del cierre del período. En blanco antes de 2024-12-31 (el historial empieza ahí).
	measure 'HC Hist Hace 12M' =
			VAR D = EDATE ( MAX ( 'Calendario'[Date] ), -12 )
			RETURN
			    IF (
			        D >= DATE ( 2024, 12, 31 ),
			        CALCULATE (
			            DISTINCTCOUNT ( 'Asignaciones Historial'[Person Number] ),
			            'Asignaciones Historial'[Effective Latest Change] = "Yes",
			            'Asignaciones Historial'[Effective Start Date] <= D,
			            'Asignaciones Historial'[Fin Vigencia HC] >= D,
			            'Asignaciones Historial'[Assignment Status Type] = "Active",
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[País Overview] ), ( NOT ISFILTERED ( 'Dim Persona'[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( 'Dim Persona'[País Overview] ) ) && ( NOT ISFILTERED ( Asignaciones[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( Asignaciones[País Overview] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Country] ), ( NOT ISFILTERED ( 'Dim Persona'[País] ) || 'Asignaciones Historial'[Country] IN FILTERS ( 'Dim Persona'[País] ) ) && ( NOT ISFILTERED ( Asignaciones[Country] ) || 'Asignaciones Historial'[Country] IN FILTERS ( Asignaciones[Country] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Legal Employer Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Entidad Legal] ) || 'Asignaciones Historial'[Legal Employer Name] IN FILTERS ( 'Dim Persona'[Entidad Legal] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Ámbito] ), ( NOT ISFILTERED ( 'Dim Persona'[Ámbito] ) || 'Asignaciones Historial'[Ámbito] IN FILTERS ( 'Dim Persona'[Ámbito] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Cross Charge Entity Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( 'Dim Persona'[Cross Charge Entity Name] ) ) && ( NOT ISFILTERED ( Asignaciones[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( Asignaciones[Cross Charge Entity Name] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[EPM Main Function Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Función] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( 'Dim Persona'[Función] ) ) && ( NOT ISFILTERED ( Asignaciones[EPM Main Function Name] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( Asignaciones[EPM Main Function Name] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Labor Type] ), ( NOT ISFILTERED ( 'Dim Persona'[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( 'Dim Persona'[Labor Type] ) ) && ( NOT ISFILTERED ( Asignaciones[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( Asignaciones[Labor Type] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( 'Dim Persona'[Grade] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Name] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( Asignaciones[Grade Name] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Grupo] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( 'Dim Persona'[Grade Grupo] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( Asignaciones[Grade Grupo] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Nivel] ), ( NOT ISFILTERED ( 'Dim Persona'[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( 'Dim Persona'[Nivel] ) ) && ( NOT ISFILTERED ( Asignaciones[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( Asignaciones[Nivel] ) ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Esquema MBO] ), ( NOT ISFILTERED ( 'Dim Persona'[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( 'Dim Persona'[Esquema MBO] ) ) && ( NOT ISFILTERED ( Asignaciones[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( Asignaciones[Esquema MBO] ) ) ) )
			        )
			    )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 52e8b11b-fb1b-4518-9c7c-786105acea05

	/// Variación del HC histórico contra 12 meses antes.
	measure 'Δ HC Hist vs 12M' = IF ( NOT ISBLANK ( [HC Hist Hace 12M] ), [HC Hist Fin] - [HC Hist Hace 12M] )
		formatString: +#,##0;-#,##0;0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 3351f65a-7c23-4c84-8391-0a5bb379f3c6

	/// Eventos del período (altas, bajas, promociones, cambios de puesto y de manager), uno por asignación, fecha y tipo. Abrir por 'Asignaciones Historial'[Tipo Evento]. Respeta los slicers de 'Dim Persona' y Asignaciones aplicándolos a los atributos vigentes en cada fecha.
	measure 'Eventos Hist' =
			VAR Ini = MIN ( 'Calendario'[Date] )
			VAR Fin = MAX ( 'Calendario'[Date] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Asignaciones Historial'[Clave Evento] ),
			    'Asignaciones Historial'[Fecha Evento] >= Ini,
			    'Asignaciones Historial'[Fecha Evento] <= Fin,
			    KEEPFILTERS ( 'Asignaciones Historial'[Tipo Evento] <> "Otro" ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[País Overview] ), ( NOT ISFILTERED ( 'Dim Persona'[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( 'Dim Persona'[País Overview] ) ) && ( NOT ISFILTERED ( Asignaciones[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( Asignaciones[País Overview] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Country] ), ( NOT ISFILTERED ( 'Dim Persona'[País] ) || 'Asignaciones Historial'[Country] IN FILTERS ( 'Dim Persona'[País] ) ) && ( NOT ISFILTERED ( Asignaciones[Country] ) || 'Asignaciones Historial'[Country] IN FILTERS ( Asignaciones[Country] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Legal Employer Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Entidad Legal] ) || 'Asignaciones Historial'[Legal Employer Name] IN FILTERS ( 'Dim Persona'[Entidad Legal] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Ámbito] ), ( NOT ISFILTERED ( 'Dim Persona'[Ámbito] ) || 'Asignaciones Historial'[Ámbito] IN FILTERS ( 'Dim Persona'[Ámbito] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Cross Charge Entity Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( 'Dim Persona'[Cross Charge Entity Name] ) ) && ( NOT ISFILTERED ( Asignaciones[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( Asignaciones[Cross Charge Entity Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[EPM Main Function Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Función] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( 'Dim Persona'[Función] ) ) && ( NOT ISFILTERED ( Asignaciones[EPM Main Function Name] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( Asignaciones[EPM Main Function Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Labor Type] ), ( NOT ISFILTERED ( 'Dim Persona'[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( 'Dim Persona'[Labor Type] ) ) && ( NOT ISFILTERED ( Asignaciones[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( Asignaciones[Labor Type] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( 'Dim Persona'[Grade] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Name] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( Asignaciones[Grade Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Grupo] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( 'Dim Persona'[Grade Grupo] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( Asignaciones[Grade Grupo] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Nivel] ), ( NOT ISFILTERED ( 'Dim Persona'[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( 'Dim Persona'[Nivel] ) ) && ( NOT ISFILTERED ( Asignaciones[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( Asignaciones[Nivel] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Esquema MBO] ), ( NOT ISFILTERED ( 'Dim Persona'[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( 'Dim Persona'[Esquema MBO] ) ) && ( NOT ISFILTERED ( Asignaciones[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( Asignaciones[Esquema MBO] ) ) ) )
			)
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: f8978296-e003-4e93-836d-69cb246b53a0

	/// Ingresos reales del período (Hire, Rehire, Add Contingent Worker). Excluye las asignaciones efímeras (abiertas y cerradas sin evento de baja).
	measure 'Altas Hist' = CALCULATE ( [Eventos Hist], 'Asignaciones Historial'[Tipo Evento] = "Alta" )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 8279b965-41ab-4a48-8b37-58d00a503076

	/// Bajas reales del período (Terminate Work Relationship), fechadas en el último día trabajado. Excluye asignaciones efímeras.
	measure 'Bajas Hist' = CALCULATE ( [Eventos Hist], 'Asignaciones Historial'[Tipo Evento] = "Baja" )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 4301d4a6-da98-40aa-a7fa-d9107201969c

	/// Bajas voluntarias del período según 'Tipo de baja' de Oracle.
	measure 'Bajas Voluntarias Hist' = CALCULATE ( [Eventos Hist], 'Asignaciones Historial'[Tipo Evento] = "Baja", 'Asignaciones Historial'[Tipo de baja] = "Voluntary" )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: bce87d91-0b83-421c-ad09-432afe5f343e

	/// Bajas involuntarias del período según 'Tipo de baja' de Oracle.
	measure 'Bajas Involuntarias Hist' = CALCULATE ( [Eventos Hist], 'Asignaciones Historial'[Tipo Evento] = "Baja", 'Asignaciones Historial'[Tipo de baja] = "Involuntary" )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 1ede143b-3735-49cf-a97c-9f79766daacc

	/// Promociones (acción Promote) del período.
	measure 'Promociones Hist' = CALCULATE ( [Eventos Hist], 'Asignaciones Historial'[Tipo Evento] = "Promoción" )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 3947777a-0297-421a-b747-18b432bf7b0b

	/// Cambios de asignación (Change Employment) del período.
	measure 'Cambios de Puesto Hist' = CALCULATE ( [Eventos Hist], 'Asignaciones Historial'[Tipo Evento] = "Cambio de puesto" )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 7cefe09b-a774-47f1-abc0-60912e5d4162

	/// Cambios de manager del período.
	measure 'Cambios de Manager Hist' = CALCULATE ( [Eventos Hist], 'Asignaciones Historial'[Tipo Evento] = "Cambio de manager" )
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 3a81b673-45a2-4dcc-b8a8-057de435713b

	/// Movimientos internos del período: promociones + cambios de puesto + cambios de manager.
	measure 'Movimientos Internos Hist' = [Promociones Hist] + [Cambios de Puesto Hist] + [Cambios de Manager Hist]
		formatString: #,##0
		displayFolder: 11 · Historial (PIT)
		lineageTag: 0edc95b9-da58-4de3-8085-2ecfec4d8498

	/// Bajas reales / HC promedio histórico.
	measure 'Rotación % Hist' = DIVIDE ( [Bajas Hist], [HC Hist Promedio] )
		formatString: 0.0%
		displayFolder: 11 · Historial (PIT)
		lineageTag: 450e8285-4618-49fb-b2be-1fd005ac7e0e

	/// Bajas voluntarias / HC promedio histórico.
	measure 'Rotación Voluntaria % Hist' = DIVIDE ( [Bajas Voluntarias Hist], [HC Hist Promedio] )
		formatString: 0.0%
		displayFolder: 11 · Historial (PIT)
		lineageTag: 1f9245ae-96cb-4fde-82fc-649a54786a17

	/// Bajas involuntarias / HC promedio histórico.
	measure 'Rotación Involuntaria % Hist' = DIVIDE ( [Bajas Involuntarias Hist], [HC Hist Promedio] )
		formatString: 0.0%
		displayFolder: 11 · Historial (PIT)
		lineageTag: 976cf72a-0fb0-4ba6-9e97-47264c4fea82

	/// Altas reales / HC promedio histórico.
	measure 'Tasa Contratación % Hist' = DIVIDE ( [Altas Hist], [HC Hist Promedio] )
		formatString: 0.0%
		displayFolder: 11 · Historial (PIT)
		lineageTag: d95201b7-5034-4a62-bda9-449901df970d

	/// Promociones / HC promedio histórico.
	measure 'Tasa Promoción % Hist' = DIVIDE ( [Promociones Hist], [HC Hist Promedio] )
		formatString: 0.0%
		displayFolder: 11 · Historial (PIT)
		lineageTag: 6bc73529-45c9-4674-8b1f-e949476b1c1e

	/// Debe ser ~0 sin slicers de atributos: el corte por fechas de ingreso/baja y el historial coinciden salvo personas con varias asignaciones. Con slicers puede diferir porque el historial usa los atributos de cada fecha.
	measure 'Val · Δ HC Fin Hist vs Actual' = [HC Hist Fin] - [HC Activo Fin]
		formatString: +#,##0;-#,##0;0
		displayFolder: 12 · Validación Historial
		lineageTag: 6af47b0c-28ed-4cc1-9bf3-f5ccc04f3ea4

	/// Diferencia de altas. Negativa: [Altas] cuenta las asignaciones efímeras como ingresos.
	measure 'Val · Δ Altas Hist vs Actual' = [Altas Hist] - [Altas]
		formatString: +#,##0;-#,##0;0
		displayFolder: 12 · Validación Historial
		lineageTag: 8522765e-cacf-4dc8-87fd-4f71e7a6957f

	/// Diferencia de bajas. Negativa: [Bajas] cuenta como baja el cierre de asignaciones efímeras.
	measure 'Val · Δ Bajas Hist vs Actual' = [Bajas Hist] - [Bajas]
		formatString: +#,##0;-#,##0;0
		displayFolder: 12 · Validación Historial
		lineageTag: 7846c419-485d-4312-9853-c715ee5ed936

	/// Asignaciones cerradas en el período sin evento de baja (pending workers / asignaciones administrativas abiertas y cerradas casi en el día). Explican la diferencia de [Bajas] contra [Bajas Hist].
	measure 'Val · Asignaciones Efímeras' =
			VAR Ini = MIN ( 'Calendario'[Date] )
			VAR Fin = MAX ( 'Calendario'[Date] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Asignaciones Historial'[Assignment Number] ),
			    'Asignaciones Historial'[Asignación Efímera] = "Sí",
			    'Asignaciones Historial'[Termination Date] >= Ini,
			    'Asignaciones Historial'[Termination Date] <= Fin,
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[País Overview] ), ( NOT ISFILTERED ( 'Dim Persona'[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( 'Dim Persona'[País Overview] ) ) && ( NOT ISFILTERED ( Asignaciones[País Overview] ) || 'Asignaciones Historial'[País Overview] IN FILTERS ( Asignaciones[País Overview] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Country] ), ( NOT ISFILTERED ( 'Dim Persona'[País] ) || 'Asignaciones Historial'[Country] IN FILTERS ( 'Dim Persona'[País] ) ) && ( NOT ISFILTERED ( Asignaciones[Country] ) || 'Asignaciones Historial'[Country] IN FILTERS ( Asignaciones[Country] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Legal Employer Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Entidad Legal] ) || 'Asignaciones Historial'[Legal Employer Name] IN FILTERS ( 'Dim Persona'[Entidad Legal] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Ámbito] ), ( NOT ISFILTERED ( 'Dim Persona'[Ámbito] ) || 'Asignaciones Historial'[Ámbito] IN FILTERS ( 'Dim Persona'[Ámbito] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Cross Charge Entity Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( 'Dim Persona'[Cross Charge Entity Name] ) ) && ( NOT ISFILTERED ( Asignaciones[Cross Charge Entity Name] ) || 'Asignaciones Historial'[Cross Charge Entity Name] IN FILTERS ( Asignaciones[Cross Charge Entity Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[EPM Main Function Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Función] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( 'Dim Persona'[Función] ) ) && ( NOT ISFILTERED ( Asignaciones[EPM Main Function Name] ) || 'Asignaciones Historial'[EPM Main Function Name] IN FILTERS ( Asignaciones[EPM Main Function Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Labor Type] ), ( NOT ISFILTERED ( 'Dim Persona'[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( 'Dim Persona'[Labor Type] ) ) && ( NOT ISFILTERED ( Asignaciones[Labor Type] ) || 'Asignaciones Historial'[Labor Type] IN FILTERS ( Asignaciones[Labor Type] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Name] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( 'Dim Persona'[Grade] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Name] ) || 'Asignaciones Historial'[Grade Name] IN FILTERS ( Asignaciones[Grade Name] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Grade Grupo] ), ( NOT ISFILTERED ( 'Dim Persona'[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( 'Dim Persona'[Grade Grupo] ) ) && ( NOT ISFILTERED ( Asignaciones[Grade Grupo] ) || 'Asignaciones Historial'[Grade Grupo] IN FILTERS ( Asignaciones[Grade Grupo] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Nivel] ), ( NOT ISFILTERED ( 'Dim Persona'[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( 'Dim Persona'[Nivel] ) ) && ( NOT ISFILTERED ( Asignaciones[Nivel] ) || 'Asignaciones Historial'[Nivel] IN FILTERS ( Asignaciones[Nivel] ) ) ) ),
			    KEEPFILTERS ( FILTER ( ALL ( 'Asignaciones Historial'[Esquema MBO] ), ( NOT ISFILTERED ( 'Dim Persona'[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( 'Dim Persona'[Esquema MBO] ) ) && ( NOT ISFILTERED ( Asignaciones[Esquema MBO] ) || 'Asignaciones Historial'[Esquema MBO] IN FILTERS ( Asignaciones[Esquema MBO] ) ) ) )
			)
		formatString: #,##0
		displayFolder: 12 · Validación Historial
		lineageTag: b69c5d3a-4e2c-462a-8af0-c308be6e29da

	/// HC Fin - (Inicio + Altas - Bajas) con el historial. Diferencias chicas = personas con más de una asignación (transferencias entre entidades, reingresos).
	measure 'Val · Conciliación Hist' = [HC Hist Fin] - ( [HC Hist Inicio] + [Altas Hist] - [Bajas Hist] )
		formatString: +#,##0;-#,##0;0
		displayFolder: 12 · Validación Historial
		lineageTag: a8638be7-66eb-4a23-9fe7-90dab3d73a10

