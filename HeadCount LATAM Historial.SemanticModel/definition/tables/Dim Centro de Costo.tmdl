/// Dimensión DESCONECTADA con los códigos de centro de costo presentes en Oracle y/o en el archivo Manual. OJO: Oracle pobla "Local Cost Center" en una minoría de registros, así que la mayoría de las filas van a figurar como "Solo Manual".
table 'Dim Centro de Costo'
	lineageTag: 5a17c982-4b60-4e37-8d25-9c31f0e6ab74

	/// HC activo de Oracle para el centro de costo seleccionado.
	measure 'HC Oracle x CC' =
			CALCULATE (
			    [HC Activo],
			    TREATAS ( VALUES ( 'Dim Centro de Costo'[ID Centro de Costo] ), 'Excel HC Oracle'[Local Cost Center] )
			)
		formatString: #,##0
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: 5a17c982-4b60-4e37-8d25-9c31f0e6ab76

	/// HC del archivo Manual a Jun-2026 para el centro de costo seleccionado.
	measure 'HC Manual x CC' =
			CALCULATE (
			    [HC Manual Jun-2026],
			    TREATAS ( VALUES ( 'Dim Centro de Costo'[ID Centro de Costo] ), 'HC Manual LATAM'[ID Centro de Costo] )
			)
		formatString: #,##0
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: 5a17c982-4b60-4e37-8d25-9c31f0e6ab77

	measure 'Δ CC (Oracle - Manual)' = [HC Oracle x CC] - [HC Manual x CC]
		formatString: +#,##0;-#,##0;0
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: 5a17c982-4b60-4e37-8d25-9c31f0e6ab78

	/// Indica si el código de centro de costo existe en los dos orígenes o en uno solo.
	measure 'Estado Cruce CC' =
			VAR O = [HC Oracle x CC]
			VAR M = [HC Manual x CC]
			RETURN
			    SWITCH (
			        TRUE (),
			        O > 0 && M > 0, "En ambos",
			        O > 0, "Solo Oracle",
			        M > 0, "Solo Manual",
			        "—"
			    )
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: 5a17c982-4b60-4e37-8d25-9c31f0e6ab79

	column 'ID Centro de Costo'
		dataType: string
		lineageTag: 5a17c982-4b60-4e37-8d25-9c31f0e6ab75
		summarizeBy: none
		isNameInferred
		sourceColumn: [ID Centro de Costo]

		annotation SummarizationSetBy = Automatic

	partition 'Dim Centro de Costo' = calculated
		mode: import
		source =
				VAR Oracle =
				    SELECTCOLUMNS ( 'Excel HC Oracle', "ID Centro de Costo", 'Excel HC Oracle'[Local Cost Center] )
				VAR Manual =
				    SELECTCOLUMNS ( 'HC Manual LATAM', "ID Centro de Costo", 'HC Manual LATAM'[ID Centro de Costo] )
				VAR Todos =
				    DISTINCT ( UNION ( Oracle, Manual ) )
				RETURN
				    FILTER ( Todos, NOT [ID Centro de Costo] IN { "", "Sin Datos", "0" } )

	annotation PBI_Id = c4d8091ba63f7e25

