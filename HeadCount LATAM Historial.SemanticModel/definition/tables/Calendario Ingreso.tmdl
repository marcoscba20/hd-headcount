/// Calendario de FECHA DE INGRESO. Relacionado activamente con 'Excel HC Oracle'[Enterprise Hire Date]. Usar para analizar altas por cohorte de ingreso. NO usarlo como eje de rotación ni de evolución de headcount: para eso está la tabla 'Calendario' (desconectada). Arranca en 1977 porque hay ingresos desde esa fecha.
table 'Calendario Ingreso'
	lineageTag: 3f8a25c1-64b7-4e09-a3d5-91c47e026b8f
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: 5c19b7e4-2a80-4f36-b95c-73e18d0a4265
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Año
		dataType: int64
		lineageTag: 91d64c07-b3e5-4a28-8f70-2c95a6013eb4
		summarizeBy: none
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column 'Nº Mes'
		dataType: int64
		lineageTag: 7a03e59b-1c46-4d82-95af-6b0e743c218d
		summarizeBy: none
		sourceColumn: [Nº Mes]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: 2e85f13a-9067-4b54-a1c8-40d972be536f
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: 'Nº Mes'

		annotation SummarizationSetBy = Automatic

	column Año-Mes
		dataType: string
		lineageTag: 8b47c206-5e91-4a73-bd60-19f3e58ac407
		summarizeBy: none
		sourceColumn: [Año-Mes]
		sortByColumn: 'Año-Mes Orden'

		annotation SummarizationSetBy = Automatic

	column 'Año-Mes Orden'
		dataType: int64
		lineageTag: 4d10a862-7f39-4c05-92eb-6a84c15703de
		summarizeBy: none
		sourceColumn: [Año-Mes Orden]

		annotation SummarizationSetBy = Automatic

	column 'Nº Trimestre'
		dataType: int64
		lineageTag: 6f92b405-38ce-4d17-8a63-c50e29d7b184
		summarizeBy: none
		sourceColumn: [Nº Trimestre]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: 1c58e7d3-0b46-49a2-95f1-8347d0e64ba2
		summarizeBy: none
		sourceColumn: [Trimestre]
		sortByColumn: 'Nº Trimestre'

		annotation SummarizationSetBy = Automatic

	column Año-Trimestre
		dataType: string
		lineageTag: 9e34172b-c805-4f6d-be2a-7405c19e836d
		summarizeBy: none
		sourceColumn: [Año-Trimestre]

		annotation SummarizationSetBy = Automatic

	partition 'Calendario Ingreso' = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(1977, 1, 1), DATE(YEAR(TODAY()) + 1, 12, 31)),
				    "Año", YEAR([Date]),
				    "Nº Mes", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMM"),
				    "Año-Mes", FORMAT([Date], "yyyy-MM"),
				    "Año-Mes Orden", YEAR([Date]) * 100 + MONTH([Date]),
				    "Nº Trimestre", ROUNDUP(MONTH([Date]) / 3, 0),
				    "Trimestre", "T" & ROUNDUP(MONTH([Date]) / 3, 0),
				    "Año-Trimestre", FORMAT([Date], "yyyy") & "-T" & ROUNDUP(MONTH([Date]) / 3, 0)
				)

	annotation PBI_Id = CalendarioIngreso

