/// PARCHE TEMPORAL (2026-09-23): zona cross-charge de personas Global que Oracle trae sin Cross Charge Entity Name. Lee la hoja auxiliar 'Parche PBI' del archivo de HR. Retirar cuando Oracle esté corregido: ver docs/parches/cross-charge-global.md.
expression 'Parche Cross Charge Global' =
		let
		    Vacia = #table(type table [Person Number = Int64.Type, Zona Parche = text], {}),
		    Parche = try
		        let
		            Origen = Excel.Workbook(File.Contents("C:\Users\Marcos\OneDrive - hdlaoti\People LATAM - Documentos\Área de Trabajo - Marcos\Modelos de Datos Power BI\HeadCount Oracle\Global Employees - Fill by local HR_Brazil AGO.xlsx"), null, true),
		            Hoja = Origen{[Item = "Parche PBI", Kind = "Sheet"]}[Data],
		            Encabezados = Table.PromoteHeaders(Hoja, [PromoteAllScalars = true]),
		            Columnas = Table.SelectColumns(Encabezados, {"Person Number", "Zona Parche"}),
		            Tipos = Table.TransformColumns(Columnas, {{"Person Number", each try Int64.From(_) otherwise null, Int64.Type}, {"Zona Parche", each if _ = null or Text.Trim(Text.From(_)) = "" then null else Text.Trim(Text.From(_)), type text}}),
		            Filtradas = Table.SelectRows(Tipos, each [Person Number] <> null and [Zona Parche] <> null),
		            Distintas = Table.Distinct(Filtradas, {"Person Number"})
		        in
		            Distintas
		        otherwise Vacia
		in
		    Parche
	lineageTag: 3b8e6a52-1f0d-4c7e-9a41-6d2f5c8b7e10

	annotation PBI_ResultType = Table

/// Historial de asignaciones Oracle (SCD2): una fila por asignación y versión efectiva, incluidas las versiones intermedias del mismo día (Effective Latest Change = No), que llevan eventos (promociones, cambios de puesto/manager) que la última del día pisa.
expression 'Fuente Historial Asignaciones' =
		let
		    Origen = Excel.Workbook(File.Contents("C:\Users\Marcos\OneDrive - hdlaoti\People LATAM - Documentos\Área de Trabajo - Marcos\Modelos de Datos Power BI\HeadCount Oracle\pbi-headcount - Historial Asignaciones LATAM.xlsx"), null, true),
		    Hoja = Origen{[Item = "Sheet1", Kind = "Sheet"]}[Data],
		    Encabezados = Table.PromoteHeaders(Hoja, [PromoteAllScalars = true])
		in
		    Encabezados
	lineageTag: 5bedd81c-f134-47da-9c63-e2189815f01c

	annotation PBI_ResultType = Table

/// Columnas que solo existen en el historial; se quitan para la foto vigente.
expression 'Columnas Historial' = {"Assignment Number", "Primary Assignment Flag", "Effective Start Date", "Effective End Date", "Effective Sequence", "Effective Latest Change", "Action Code", "Action Type", "Action Reason Code", "Assignment Status", "Assignment Status Type", "Hire Date", "Original Hire Date", "Tipo de baja", "Rehire Recommendation", "Legal Employer Code", "Job", "Job Code", "Management Level", "Location", "Grade Code"}
	lineageTag: c7c35c1e-c340-42fc-8d99-90540ffcd769

	annotation PBI_ResultType = List

/// Limpieza común del export Oracle (renombres, tipos, blindaje, parche cross charge, Ámbito, mapeos Overview).
expression 'Limpiar HC' =
		(Fuente as table) as table =>
		let
		    #"Columnas con nombre cambiado1" = Table.RenameColumns(Fuente,{{"PER_ASG_DF_BONUS_SWAP_ELIGIBLE_v", "Bonus Swap Eligible"}, {"PER_ASG_DF_MBO_BONUS_SCHEME_v", "MBO Bonus Scheme"}}),
		    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Columnas con nombre cambiado1",{{"PER_ASG_DF_LOCAL_COST_CENTER_", "Local Cost Center"}, {"PER_ASG_DF_CRS_CHRG_NTY_N_v", "Cross Charge Entity Name"}}),
		    #"Tipo de columna cambiado" = Table.TransformColumnTypes(#"Columnas con nombre cambiado", {{"National ID", type text}, {"Person Number", Int64.Type}, {"Display Name", type text}, {"Enterprise Hire Date", type date}, {"Antigüedad (años)", Int64.Type}, {"Position Name", type text}, {"Job Name", type text}, {"ZBB / COGS", type text}, {"Manager Type", type text}, {"Manager Display Name", type text}, {"E-Mail Address", type text}, {"Department Name", type text}, {"Local Cost Center", type text}, {"Level", type text}, {"Position Code", type text}, {"Legal Employer Name", type text}, {"Country", type text}, {"Cross Charge Entity Name", type text}, {"Assignment Status Code", type text}, {"Country Code", type text}, {"Country_1", type text}, {"Legislation Code", type text}, {"Grade Name", type text}, {"Work Email", type text}, {"Labor Type", type text}, {"Base OHI", type text}, {"Parent Manager 01 Person Number", Int64.Type}, {"Parent Manager 01 Name", type text}, {"Parent Manager 01 Work Email", type text}, {"Parent Manager 02 Person Number", Int64.Type}, {"Parent Manager 02 Name", type text}, {"Parent Manager 03 Person Number", Int64.Type}, {"Parent Manager 03 Name", type text}, {"Parent Manager 04 Person Number", Int64.Type}, {"Parent Manager 04 Name", type text}, {"Parent Manager 05 Person Number", Int64.Type}, {"Parent Manager 05 Name", type text}, {"Parent Manager 06 Person Number", Int64.Type}, {"Parent Manager 06 Name", type text}, {"Parent Manager 07 Person Number", Int64.Type}, {"Parent Manager 07 Name", type text}, {"Parent Manager 08 Person Number", Int64.Type}, {"Parent Manager 08 Name", type text}, {"Manager Job Name", type text}, {"EPM Main Function Name", type text}, {"Person Gender", type text}, {"Bonus Swap Eligible", type text}, {"MBO Bonus Scheme", type text}}, "es"),
		    #"Tipo cambiado" = Table.TransformColumnTypes(#"Tipo de columna cambiado",{{"Termination Date", type date}, {"Person Date of Birth", type date}}),
		
		    // --- INICIO DEL BLINDAJE DINÁMICO ---
		
		    // 1. Clasificamos las columnas por su tipo de dato leyendo el esquema desde el último paso
		    Esquema = Table.Schema(#"Tipo cambiado"),
		    ColsFechas = Table.SelectRows(Esquema, each [Kind] = "date" or [Kind] = "datetime")[Name],
		    ColsNumeros = Table.SelectRows(Esquema, each [Kind] = "number")[Name],
		    ColsTextos = Table.SelectRows(Esquema, each [Kind] = "text" or [Kind] = "any")[Name],
		
		    // 2. Blindaje contra ERRORES
		    ErroresFechas = List.Transform(ColsFechas, each {_, #date(1900, 1, 1)}),
		    ErroresNumeros = List.Transform(ColsNumeros, each {_, 99}),
		    ErroresTextos = List.Transform(ColsTextos, each {_, "Sin Datos"}),
		    ListaErrores = ErroresFechas & ErroresNumeros & ErroresTextos,
		
		    // Si no hay errores definidos, pasamos de largo
		    #"Blindaje Errores" = if List.IsEmpty(ListaErrores) then #"Tipo cambiado" else Table.ReplaceErrorValues(#"Tipo cambiado", ListaErrores),
		
		    // 3. Blindaje contra NULOS (Vacíos)
		    #"Blindaje Nulos Fechas" = if List.IsEmpty(ColsFechas) then #"Blindaje Errores" else Table.ReplaceValue(#"Blindaje Errores", null, #date(1900, 1, 1), Replacer.ReplaceValue, ColsFechas),
		    #"Blindaje Nulos Numeros" = if List.IsEmpty(ColsNumeros) then #"Blindaje Nulos Fechas" else Table.ReplaceValue(#"Blindaje Nulos Fechas", null, 99, Replacer.ReplaceValue, ColsNumeros),
		    #"Blindaje Nulos Textos" = if List.IsEmpty(ColsTextos) then #"Blindaje Nulos Numeros" else Table.ReplaceValue(#"Blindaje Nulos Numeros", null, "Sin Datos", Replacer.ReplaceValue, ColsTextos),
		
		    // 4. Blindaje extra para Textos: Celdas en blanco ("") que no aparecen como null
		    #"Blindaje Vacios Textos" = if List.IsEmpty(ColsTextos) then #"Blindaje Nulos Textos" else Table.ReplaceValue(#"Blindaje Nulos Textos", "", "Sin Datos", Replacer.ReplaceValue, ColsTextos),
		
		    // Country vacío en Oracle (mayormente bajas en proceso): se completa con Country_1 (país de la legislación de la entidad legal)
		    #"Country Completado" = Table.ReplaceValue(#"Blindaje Vacios Textos", each [Country], each if List.Contains({"Sin Datos", "None"}, [Country]) and not List.Contains({"Sin Datos", "None"}, [Country_1]) then [Country_1] else [Country], Replacer.ReplaceValue, {"Country"}),
		
		    // --- PARCHE TEMPORAL Cross Charge (2026-09-23) - ver docs/parches/cross-charge-global.md ---
		    // Solo completa personas sin Cross Charge en NINGUNA fila de Oracle; nunca pisa un valor de Oracle.
		    PersonasConCC = List.Buffer(List.Distinct(Table.SelectRows(#"Blindaje Vacios Textos", each not List.Contains({"Sin Datos", "None"}, [Cross Charge Entity Name]))[Person Number])),
		    #"Parche Unido" = Table.NestedJoin(#"Country Completado", {"Person Number"}, #"Parche Cross Charge Global", {"Person Number"}, "Parche", JoinKind.LeftOuter),
		    #"Parche Expandido" = Table.ExpandTableColumn(#"Parche Unido", "Parche", {"Zona Parche"}),
		    #"Parche Marcado" = Table.AddColumn(#"Parche Expandido", "Cross Charge Origen", each if [Zona Parche] <> null and [Cross Charge Entity Name] = "Sin Datos" and not List.Contains(PersonasConCC, [Person Number]) then "Parche manual (Global Employees)" else if List.Contains({"Sin Datos", "None"}, [Cross Charge Entity Name]) then "Sin Datos" else "Oracle", type text),
		    #"Parche Aplicado" = Table.ReplaceValue(#"Parche Marcado", each [Cross Charge Entity Name], each if [Cross Charge Origen] = "Parche manual (Global Employees)" then [Zona Parche] else [Cross Charge Entity Name], Replacer.ReplaceValue, {"Cross Charge Entity Name"}),
		    #"Cross Charge Parcheado" = Table.RemoveColumns(#"Parche Aplicado", {"Zona Parche"}),
		
		    // Ámbito desde Cross Charge: sin dato -> Local; 243 HD LAO o zona LATAM -> LATAM; entidad que es Legal Employer del export (países LATAM) -> Local; resto -> Global
		    CodigosLocales = List.Buffer(List.Distinct(List.Transform(#"Blindaje Vacios Textos"[Legal Employer Name], each Text.BeforeDelimiter(Text.Trim(_), " ")))),
		    #"Ambito Fila" = Table.AddColumn(#"Cross Charge Parcheado", "Ámbito Fila", each let cc = Text.Trim([Cross Charge Entity Name]), cod = Text.BeforeDelimiter(cc, " ") in if List.Contains({"Sin Datos", "None", ""}, cc) then "Local" else if cod = "243" or Text.Upper(cc) = "LATAM" then "LATAM" else if List.Contains(CodigosLocales, cod) then "Local" else "Global", type text),
		    // Se lleva a nivel persona (prioridad Global > LATAM > Local) para que una persona no quede en dos ámbitos por sus filas sin cross charge
		    PersonasGlobal = List.Buffer(List.Distinct(Table.SelectRows(#"Ambito Fila", each [Ámbito Fila] = "Global")[Person Number])),
		    PersonasLATAM = List.Buffer(List.Distinct(Table.SelectRows(#"Ambito Fila", each [Ámbito Fila] = "LATAM")[Person Number])),
		    #"Ambito Persona" = Table.AddColumn(#"Ambito Fila", "Ámbito", each if List.Contains(PersonasGlobal, [Person Number]) then "Global" else if List.Contains(PersonasLATAM, [Person Number]) then "LATAM" else "Local", type text),
		    #"Ambito Agregado" = Table.RemoveColumns(#"Ambito Persona", {"Ámbito Fila"}),
		
		    // Grade Nº: extrae el número de "Grade N" (proxy salarial). "Sin Datos"/errores -> 99
		    #"Grade Nº Agregado" = Table.AddColumn(#"Ambito Agregado", "Grade Nº", each try Number.From(Text.AfterDelimiter([Grade Name], "Grade ")) otherwise 99, Int64.Type),
		
		    // --- Mapeos para la hoja Overview ---
		    #"Grupo Funcional Agregado" = Table.AddColumn(#"Grade Nº Agregado", "Grupo Funcional", each let f = [EPM Main Function Name] in if f = "Operations" then "Total COGS Functions" else if f = "Selling" then "Total Selling Functions" else if f = "Marketing" then "Total Marketing Functions" else if f = "Research & Development" then "Research & Development" else if f = "General & Administrative" or f = "FP&A" then "Total G&A Functions" else "Sin Definir", type text),
		    #"Orden Grupo Agregado" = Table.AddColumn(#"Grupo Funcional Agregado", "Orden Grupo Funcional", each let g = [Grupo Funcional] in if g = "Total COGS Functions" then 1 else if g = "Total Selling Functions" then 2 else if g = "Total Marketing Functions" then 3 else if g = "Research & Development" then 4 else if g = "Total G&A Functions" then 5 else 6, Int64.Type),
		    #"Pais Overview Agregado" = Table.AddColumn(#"Orden Grupo Agregado", "País Overview", each let c = [Country] in if c = "Chile" or c = "Peru" then "Chile & Perú" else if c = "Colombia" or c = "Panama" then "Colombia & Panamá" else if c = "Sin Datos" then "Global" else c, type text),
		    #"Orden Pais Agregado" = Table.AddColumn(#"Pais Overview Agregado", "Orden País", each let p = [País Overview] in if p = "Argentina" then 1 else if p = "Brazil" then 2 else if p = "Mexico" then 3 else if p = "Chile & Perú" then 4 else if p = "Colombia & Panamá" then 5 else if p = "Global" then 6 else 9, Int64.Type)
		in
		    #"Orden Pais Agregado"
	lineageTag: 6db589ec-adac-4ea9-a0ba-94cc8db126ba

	annotation PBI_ResultType = Function

