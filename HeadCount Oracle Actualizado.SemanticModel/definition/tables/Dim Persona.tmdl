/// Dimensión de personas conformada: un Person Number por fila. Filtra headcount, movimientos y compensación. Lo fijo de la persona (nombre, ID, género, edad, entidad, ámbito) vive solo acá; lo que cambia entre asignaciones aparece con el valor de la asignación vigente (activa primero, si no la de mayor Person Number). Las columnas sin uso del export están ocultas en la carpeta 'Oracle · otros'. -1 = salarios sin cruce con Oracle.
table 'Dim Persona'
	lineageTag: ec53350e-cd3a-4c01-9903-5845106a26ab

	/// Clave única de persona. -1 = fila de salarios que no cruzó con Oracle.
	column 'Person Number'
		dataType: int64
		formatString: 0
		lineageTag: 7bb863fd-5f37-4fdd-9b0c-8913d2688efb
		summarizeBy: none
		sourceColumn: Person Number

		annotation SummarizationSetBy = Automatic

	column Nombre
		dataType: string
		lineageTag: bd3fa45d-0da7-4cfd-9234-c446bad559c6
		summarizeBy: none
		sourceColumn: Nombre

		annotation SummarizationSetBy = Automatic

	column 'ID Nacional Oracle'
		dataType: string
		lineageTag: dfac54c1-9dcf-483b-b9d8-57bf4b8dd7d5
		summarizeBy: none
		sourceColumn: ID Nacional Oracle

		annotation SummarizationSetBy = Automatic

	column Género
		dataType: string
		lineageTag: 2f560309-7b84-4cc8-8907-926eaf2facc1
		summarizeBy: none
		sourceColumn: Género

		annotation SummarizationSetBy = Automatic

	column 'Fecha Nacimiento'
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 4b9fe6fe-48de-4e10-8d38-d91bca0f175c
		summarizeBy: none
		sourceColumn: Fecha Nacimiento

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Años cumplidos a hoy. En blanco si la fecha de nacimiento falta o la edad queda fuera de 15-80.
	column Edad =
			VAR Birth = 'Dim Persona'[Fecha Nacimiento]
			VAR E = DATEDIFF ( Birth, TODAY (), YEAR )
			RETURN
			    IF ( ISBLANK ( Birth ) || E < 15 || E > 80, BLANK (), E )
		dataType: int64
		formatString: 0
		lineageTag: 14f0d6ec-ed0a-4b7b-bbf5-84327fc8a6a4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Rango Etario' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( 'Dim Persona'[Edad] ), "Sin Dato",
			    'Dim Persona'[Edad] < 25, "< 25",
			    'Dim Persona'[Edad] < 35, "25 a 34",
			    'Dim Persona'[Edad] < 45, "35 a 44",
			    'Dim Persona'[Edad] < 55, "45 a 54",
			    "55+"
			)
		dataType: string
		lineageTag: 0769ab9a-aa26-4875-b2f4-17c66ac1a7da
		summarizeBy: none
		sortByColumn: 'Rango Etario Orden'

		annotation SummarizationSetBy = Automatic

	column 'Rango Etario Orden' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( 'Dim Persona'[Edad] ), 6,
			    'Dim Persona'[Edad] < 25, 1,
			    'Dim Persona'[Edad] < 35, 2,
			    'Dim Persona'[Edad] < 45, 3,
			    'Dim Persona'[Edad] < 55, 4,
			    5
			)
		dataType: int64
		isHidden
		lineageTag: 453b54be-dce4-46e2-9af7-cae2a99c0e0a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Enterprise Hire Date de la asignación vigente.
	column 'Fecha Ingreso'
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 15550984-bd02-44f6-8e5b-c5a4d38727d0
		summarizeBy: none
		sourceColumn: Fecha Ingreso

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Antigüedad (años)'
		dataType: int64
		formatString: 0
		lineageTag: d3814687-f09c-4d80-a155-080285b6971f
		summarizeBy: none
		sourceColumn: Antigüedad (años)

		annotation SummarizationSetBy = Automatic

	column 'Rango Antigüedad' =
			VAR A = 'Dim Persona'[Antigüedad (años)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( A ), "Sin Dato",
			        A < 1, "< 1 año",
			        A < 3, "1 a 3 años",
			        A < 5, "3 a 5 años",
			        A < 10, "5 a 10 años",
			        A < 20, "10 a 20 años",
			        "20+ años"
			    )
		dataType: string
		lineageTag: f5d57fb9-3a7e-47c5-ba55-242750606b04
		summarizeBy: none
		sortByColumn: 'Rango Antigüedad Orden'

		annotation SummarizationSetBy = Automatic

	column 'Rango Antigüedad Orden' =
			VAR A = 'Dim Persona'[Antigüedad (años)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( A ), 7, A < 1, 1, A < 3, 2, A < 5, 3, A < 10, 4, A < 20, 5, 6 )
		dataType: int64
		isHidden
		lineageTag: 4c9b70bf-bf96-421d-be0f-c8596bcf5b7d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Año Ingreso' = YEAR ( 'Dim Persona'[Fecha Ingreso] )
		dataType: int64
		formatString: 0
		lineageTag: 121b450f-3baf-47ae-97b2-7fc82cada864
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mes Ingreso Nº' = MONTH ( 'Dim Persona'[Fecha Ingreso] )
		dataType: int64
		isHidden
		lineageTag: 0e181d9e-a72a-477d-a467-747db8be52a8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mes Ingreso' = FORMAT ( 'Dim Persona'[Fecha Ingreso], "MMM" )
		dataType: string
		lineageTag: 44e118d7-ae27-4bf5-8106-68c3ad4ef1db
		summarizeBy: none
		sortByColumn: 'Mes Ingreso Nº'

		annotation SummarizationSetBy = Automatic

