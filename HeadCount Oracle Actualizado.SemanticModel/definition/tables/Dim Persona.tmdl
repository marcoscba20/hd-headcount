	partition 'Dim Persona' = m
		mode: import
		source =
				let
				    Sel = Table.SelectColumns(#"Oracle Persona Unica", {"Person Number", "Display Name", "National ID", "Person Gender", "Person Date of Birth", "Enterprise Hire Date", "Antigüedad (años)", "Ámbito", "Country", "País Overview", "Orden País", "Legal Employer Name", "Business Unit Name", "EPM Main Function Name", "Grupo Funcional", "Orden Grupo Funcional", "Department Name", "Job Name", "Position Name", "Manager Display Name", "Grade Name", "Grade Nº", "Level", "ZBB / COGS", "Labor Type", "Base OHI", "Cross Charge Entity Name", "MBO Bonus Scheme", "Bonus Swap Eligible", "Country Code", "Country_1", "Legislation Code", "Work Email", "E-Mail Address", "Manager Type", "Manager Job Name", "Position Code", "Parent Manager 01 Work Email", "Parent Manager 01 Person Number", "Parent Manager 01 Name", "Parent Manager 02 Person Number", "Parent Manager 02 Name", "Parent Manager 03 Person Number", "Parent Manager 03 Name", "Parent Manager 04 Person Number", "Parent Manager 04 Name", "Parent Manager 05 Person Number", "Parent Manager 05 Name", "Parent Manager 06 Person Number", "Parent Manager 06 Name", "Parent Manager 07 Person Number", "Parent Manager 07 Name", "Parent Manager 08 Person Number", "Parent Manager 08 Name"}),
				    Ren = Table.RenameColumns(Sel, {{"Display Name", "Nombre"}, {"National ID", "ID Nacional Oracle"}, {"Enterprise Hire Date", "Fecha Ingreso"}, {"Country", "País"}, {"Legal Employer Name", "Entidad Legal"}, {"Business Unit Name", "Business Unit"}, {"EPM Main Function Name", "Función"}, {"Department Name", "Departamento"}, {"Job Name", "Puesto"}, {"Position Name", "Posición"}, {"Manager Display Name", "Manager"}, {"Grade Name", "Grade"}}),
				    // ZBB = SG&A
				    Costo = Table.AddColumn(Ren, "Tipo de Costo", each let z = Text.Upper(Text.Trim(Text.From([#"ZBB / COGS"]))) in if z = "ZBB" then "SG&A" else if z = "COGS" then "COGS" else "Sin dato", type text),
				    // Mismas reglas que las columnas calculadas de Asignaciones (Grade Grupo, Nivel, Esquema MBO, Bonus Swap)
				    GradeGrupo = Table.AddColumn(Costo, "Grade Grupo", each if [#"Grade Nº"] = null or [#"Grade Nº"] = 99 then "Sin Grade" else if [#"Grade Nº"] >= 8 then "G8+" else "G1-G7", type text),
				    NivelTxt = Table.AddColumn(GradeGrupo, "NivelTxt", each if [Level] = null then "" else Text.Trim(Text.From([Level])), type text),
				    NivelOrden = Table.AddColumn(NivelTxt, "Nivel Orden", each if List.Contains({"0", "", "Sin Datos"}, [NivelTxt]) then 99 else (try Int64.From(Number.FromText([NivelTxt])) otherwise 99), Int64.Type),
				    Nivel = Table.AddColumn(NivelOrden, "Nivel", each if List.Contains({"0", "", "Sin Datos"}, [NivelTxt]) then "Sin Nivel" else "L" & [NivelTxt], type text),
				    Genero = Table.AddColumn(Nivel, "Género", each if [Person Gender] = "Male" then "Masculino" else if [Person Gender] = "Female" then "Femenino" else "Sin Dato", type text),
				    Mbo = Table.AddColumn(Genero, "Esquema MBO", each if [MBO Bonus Scheme] = "Yes" then "Con MBO" else if [MBO Bonus Scheme] = "No" then "Sin MBO" else "No Aplica", type text),
				    MboOrden = Table.AddColumn(Mbo, "Orden Esquema MBO", each if [MBO Bonus Scheme] = "Yes" then 1 else if [MBO Bonus Scheme] = "No" then 2 else 3, Int64.Type),
				    Swap = Table.AddColumn(MboOrden, "Bonus Swap", each if [Bonus Swap Eligible] = "Yes" then "Elegible" else if [Bonus Swap Eligible] = "No" then "No Elegible" else "No Aplica", type text),
				    SwapOrden = Table.AddColumn(Swap, "Orden Bonus Swap", each if [Bonus Swap Eligible] = "Yes" then 1 else if [Bonus Swap Eligible] = "No" then 2 else 3, Int64.Type),
				    Codigo = Table.AddColumn(SwapOrden, "Código Entidad", each Text.Start(Text.From([Entidad Legal]), 3), type text),
				    // Fecha de nacimiento: el blindaje de Oracle usa 1900-01-01 como vacío
				    Nacimiento = Table.TransformColumns(Codigo, {{"Person Date of Birth", each if _ = #date(1900, 1, 1) then null else _, type date}}),
				    Ren2 = Table.RenameColumns(Nacimiento, {{"Person Date of Birth", "Fecha Nacimiento"}}),
				    SinFuente = Table.RemoveColumns(Ren2, {"ZBB / COGS", "Level", "Person Gender", "NivelTxt", "MBO Bonus Scheme", "Bonus Swap Eligible"}),
				    SinCruce = Table.FromRecords({[#"Person Number" = -1, Nombre = "Sin cruce con Oracle", #"Ámbito" = "Sin cruce", #"País Overview" = "Sin cruce", #"Orden País" = 99, #"Tipo de Costo" = "Sin cruce", #"Grade Grupo" = "Sin Grade", Nivel = "Sin Nivel", #"Nivel Orden" = 99, #"Género" = "Sin Dato", #"Grupo Funcional" = "Sin Definir", #"Orden Grupo Funcional" = 6, #"Esquema MBO" = "No Aplica", #"Orden Esquema MBO" = 3, #"Bonus Swap" = "No Aplica", #"Orden Bonus Swap" = 3]}, null, MissingField.UseNull),
				    Todo = Table.Combine({SinFuente, SinCruce}),
				    Tipos = Table.TransformColumnTypes(Todo, {{"Person Number", Int64.Type}, {"Nombre", type text}, {"ID Nacional Oracle", type text}, {"Género", type text}, {"Fecha Nacimiento", type date}, {"Fecha Ingreso", type date}, {"Antigüedad (años)", Int64.Type}, {"Ámbito", type text}, {"País", type text}, {"País Overview", type text}, {"Orden País", Int64.Type}, {"Entidad Legal", type text}, {"Código Entidad", type text}, {"Business Unit", type text}, {"Función", type text}, {"Grupo Funcional", type text}, {"Orden Grupo Funcional", Int64.Type}, {"Departamento", type text}, {"Puesto", type text}, {"Posición", type text}, {"Manager", type text}, {"Grade", type text}, {"Grade Nº", Int64.Type}, {"Grade Grupo", type text}, {"Nivel", type text}, {"Nivel Orden", Int64.Type}, {"Tipo de Costo", type text}, {"Labor Type", type text}, {"Base OHI", type text}, {"Cross Charge Entity Name", type text}, {"Esquema MBO", type text}, {"Orden Esquema MBO", Int64.Type}, {"Bonus Swap", type text}, {"Orden Bonus Swap", Int64.Type}, {"Country Code", type text}, {"Country_1", type text}, {"Legislation Code", type text}, {"Work Email", type text}, {"E-Mail Address", type text}, {"Manager Type", type text}, {"Manager Job Name", type text}, {"Position Code", type text}, {"Parent Manager 01 Work Email", type text}, {"Parent Manager 01 Person Number", Int64.Type}, {"Parent Manager 01 Name", type text}, {"Parent Manager 02 Person Number", Int64.Type}, {"Parent Manager 02 Name", type text}, {"Parent Manager 03 Person Number", Int64.Type}, {"Parent Manager 03 Name", type text}, {"Parent Manager 04 Person Number", Int64.Type}, {"Parent Manager 04 Name", type text}, {"Parent Manager 05 Person Number", Int64.Type}, {"Parent Manager 05 Name", type text}, {"Parent Manager 06 Person Number", Int64.Type}, {"Parent Manager 06 Name", type text}, {"Parent Manager 07 Person Number", Int64.Type}, {"Parent Manager 07 Name", type text}, {"Parent Manager 08 Person Number", Int64.Type}, {"Parent Manager 08 Name", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table

