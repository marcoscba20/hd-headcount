	/// Género según Oracle, en inglés ("Male"/"Female"). Usar la columna "Género" para visualizar.
	column 'Person Gender'
		dataType: string
		isHidden
		lineageTag: 3c81f0a5-6e24-4f7b-9d13-5a0e28b7c614
		summarizeBy: none
