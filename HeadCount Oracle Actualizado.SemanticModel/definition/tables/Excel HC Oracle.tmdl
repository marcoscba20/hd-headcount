		annotation SummarizationSetBy = Automatic

	/// Fecha de nacimiento según Oracle. OJO: ~23 registros traen basura (fecha de ingreso cargada acá, 1900-01-02, nacimientos futuros). Usar la columna "Edad", que los descarta.
	column 'Person Date of Birth'
		dataType: dateTime
		isHidden
		formatString: dd/MM/yyyy
		lineageTag: 7b2e94d1-08c3-4a56-b7e0-1f9d63a48205
		summarizeBy: none
		sourceColumn: Person Date of Birth

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Género en castellano. "Sin Dato" cuando Oracle no lo informa (~4 registros).
	column Género =
			SWITCH(
			    'Excel HC Oracle'[Person Gender],
			    "Male", "Masculino",
			    "Female", "Femenino",
			    "Sin Dato"
			)
		dataType: string
		lineageTag: 9f4a1c67-b230-4e85-8a19-c7d504e3b8f2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Edad en años cumplidos al día de hoy. En blanco si la fecha de nacimiento es inválida (sentinel 1900-01-01 o edad fuera del rango 15-80).
	column Edad =
			
			VAR Birth = 'Excel HC Oracle'[Person Date of Birth]
			VAR E = DATEDIFF ( Birth, TODAY (), YEAR )
			RETURN
			    IF ( Birth = DATE ( 1900, 1, 1 ) || E < 15 || E > 80, BLANK (), E )
		dataType: int64
		formatString: 0
		lineageTag: 2d8b5e40-91af-4c73-a6d2-e05f18734b9c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Bucket etario. "Sin Dato" cuando la fecha de nacimiento es inválida.
	column 'Rango Etario' =
			SWITCH(
			    TRUE(),
			    ISBLANK ( 'Excel HC Oracle'[Edad] ), "Sin Dato",
			    'Excel HC Oracle'[Edad] < 25, "< 25",
			    'Excel HC Oracle'[Edad] < 35, "25 a 34",
			    'Excel HC Oracle'[Edad] < 45, "35 a 44",
			    'Excel HC Oracle'[Edad] < 55, "45 a 54",
			    "55+"
			)
		dataType: string
		lineageTag: 6a03d7f2-4e18-4b90-9c25-8f710e3a4b61
		summarizeBy: none
		sortByColumn: 'Rango Etario Orden'

		annotation SummarizationSetBy = Automatic

	column 'Rango Etario Orden' =
			SWITCH(
			    TRUE(),
			    ISBLANK ( 'Excel HC Oracle'[Edad] ), 6,
			    'Excel HC Oracle'[Edad] < 25, 1,
			    'Excel HC Oracle'[Edad] < 35, 2,
			    'Excel HC Oracle'[Edad] < 45, 3,
			    'Excel HC Oracle'[Edad] < 55, 4,
			    5
			)
		dataType: int64
		lineageTag: 4e91c8a3-7d52-4f16-b80e-3a2c96d15f78
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Nivel jerárquico legible: L1 (más alto) a L9. "Sin Nivel" para el valor 0 de Oracle, mayormente mano de obra directa.
	column Nivel =
			VAR L = 'Excel HC Oracle'[Level]
			RETURN
			    IF ( L IN { "0", "", "Sin Datos" } || ISBLANK ( L ), "Sin Nivel", "L" & L )
		dataType: string
		lineageTag: 8c25f19b-6a47-4e03-91d8-b5704e2fa63c
		summarizeBy: none
		sortByColumn: 'Nivel Orden'

		annotation SummarizationSetBy = Automatic

	/// Orden de Nivel: 1..9 según el nivel; 99 para "Sin Nivel", que queda al final.
	column 'Nivel Orden' =
			VAR L = 'Excel HC Oracle'[Level]
			RETURN
			    IF (
			        L IN { "0", "", "Sin Datos" } || ISBLANK ( L ),
			        99,
			        IFERROR ( VALUE ( L ), 99 )
			    )
		dataType: int64
		lineageTag: 5f70b3e8-2c94-4d61-a375-e8916bc042d5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Agrupación de Grade que replica el corte "G8+" de la presentación People Excellence.
	column 'Grade Grupo' =
			SWITCH(
			    TRUE(),
			    'Excel HC Oracle'[Grade Nº] = 99, "Sin Grade",
			    'Excel HC Oracle'[Grade Nº] >= 8, "G8+",
			    "G1-G7"
			)
		dataType: string
		lineageTag: 1e64a95c-8b30-42f7-9d58-c073a2e61b49
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Excel HC Oracle' = m
		mode: import
		source = ```
				let
				    Origen = Excel.Workbook(File.Contents("C:\Users\Marcos\OneDrive - hdlaoti\People LATAM - Documentos\Área de Trabajo - Marcos\Modelos de Datos Power BI\HeadCount Oracle\pbi-headcount - Reporte Semanal LATAM.xlsx"), null, true),
				    #"Navegación 1" = Origen{[Item = "Sheet1", Kind = "Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(#"Navegación 1", [PromoteAllScalars = true]),
				    #"Tipo de columna cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos", {{"National ID", type text}, {"Person Number", Int64.Type}, {"Display Name", type text}, {"Enterprise Hire Date", type date}, {"Antigüedad (años)", Int64.Type}, {"Position Name", type text}, {"Job Name", type text}, {"ZBB / COGS", type text}, {"Manager Type", type text}, {"Manager Display Name", type text}, {"E-Mail Address", type text}, {"Department Name", type text}, {"Local Cost Center", type text}, {"Level", type text}, {"Position Code", type text}, {"Legal Employer Name", type text}, {"Country", type text}, {"Cross Charge Entity Name", type text}, {"Assignment Status Code", type text}, {"Country Code", type text}, {"Country_1", type text}, {"Legislation Code", type text}, {"Grade Name", type text}, {"Work Email", type text}, {"Labor Type", type text}, {"Base OHI", type text}, {"Parent Manager 01 Person Number", Int64.Type}, {"Parent Manager 01 Name", type text}, {"Parent Manager 01 Work Email", type text}, {"Parent Manager 02 Person Number", Int64.Type}, {"Parent Manager 02 Name", type text}, {"Parent Manager 03 Person Number", Int64.Type}, {"Parent Manager 03 Name", type text}, {"Parent Manager 04 Person Number", Int64.Type}, {"Parent Manager 04 Name", type text}, {"Parent Manager 05 Person Number", Int64.Type}, {"Parent Manager 05 Name", type text}, {"Parent Manager 06 Person Number", Int64.Type}, {"Parent Manager 06 Name", type text}, {"Parent Manager 07 Person Number", Int64.Type}, {"Parent Manager 07 Name", type text}, {"Parent Manager 08 Person Number", Int64.Type}, {"Parent Manager 08 Name", type text}, {"Manager Job Name", type text}, {"EPM Main Function Name", type text}, {"Person Gender", type text}}, "es"),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Tipo de columna cambiado",{{"Termination Date", type date}, {"Person Date of Birth", type date}}),
				
				    // --- INICIO DEL BLINDAJE DINÁMICO ---
				    
				    // 1. Clasificamos las columnas por su tipo de dato leyendo el esquema desde el último paso
				    Esquema = Table.Schema(#"Tipo cambiado"),
				    ColsFechas = Table.SelectRows(Esquema, each [Kind] = "date" or [Kind] = "datetime")[Name],
				    ColsNumeros = Table.SelectRows(Esquema, each [Kind] = "number")[Name],
				    ColsTextos = Table.SelectRows(Esquema, each [Kind] = "text" or [Kind] = "any")[Name],
				
				    // 2. Blindaje contra ERRORES
				    ErroresFechas = List.Transform(ColsFechas, each {_, #date(1900, 1, 1)}),
				    ErroresNumeros = List.Transform(ColsNumeros, each {_, 99}),
				    ErroresTextos = List.Transform(ColsTextos, each {_, "Sin Datos"}),
				    ListaErrores = ErroresFechas & ErroresNumeros & ErroresTextos,
				    
				    // Si no hay errores definidos, pasamos de largo
				    #"Blindaje Errores" = if List.IsEmpty(ListaErrores) then #"Tipo cambiado" else Table.ReplaceErrorValues(#"Tipo cambiado", ListaErrores),
				
				    // 3. Blindaje contra NULOS (Vacíos)
				    #"Blindaje Nulos Fechas" = if List.IsEmpty(ColsFechas) then #"Blindaje Errores" else Table.ReplaceValue(#"Blindaje Errores", null, #date(1900, 1, 1), Replacer.ReplaceValue, ColsFechas),
				    #"Blindaje Nulos Numeros" = if List.IsEmpty(ColsNumeros) then #"Blindaje Nulos Fechas" else Table.ReplaceValue(#"Blindaje Nulos Fechas", null, 99, Replacer.ReplaceValue, ColsNumeros),
				    #"Blindaje Nulos Textos" = if List.IsEmpty(ColsTextos) then #"Blindaje Nulos Numeros" else Table.ReplaceValue(#"Blindaje Nulos Numeros", null, "Sin Datos", Replacer.ReplaceValue, ColsTextos),
				    
				    // 4. Blindaje extra para Textos: Celdas en blanco ("") que no aparecen como null
				    #"Blindaje Vacios Textos" = if List.IsEmpty(ColsTextos) then #"Blindaje Nulos Textos" else Table.ReplaceValue(#"Blindaje Nulos Textos", "", "Sin Datos", Replacer.ReplaceValue, ColsTextos),
				
				    // Grade Nº: extrae el número de "Grade N" (proxy salarial). "Sin Datos"/errores -> 99
				    #"Grade Nº Agregado" = Table.AddColumn(#"Blindaje Vacios Textos", "Grade Nº", each try Number.From(Text.AfterDelimiter([Grade Name], "Grade ")) otherwise 99, Int64.Type),
				
				    // --- Mapeos para la hoja Overview ---
				    #"Grupo Funcional Agregado" = Table.AddColumn(#"Grade Nº Agregado", "Grupo Funcional", each let f = [EPM Main Function Name] in if f = "Operations" then "Total COGS Functions" else if f = "Selling" then "Total Selling Functions" else if f = "Marketing" then "Total Marketing Functions" else if f = "Research & Development" then "Research & Development" else if f = "General & Administrative" or f = "FP&A" then "Total G&A Functions" else "Sin Definir", type text),
				    #"Orden Grupo Agregado" = Table.AddColumn(#"Grupo Funcional Agregado", "Orden Grupo Funcional", each let g = [Grupo Funcional] in if g = "Total COGS Functions" then 1 else if g = "Total Selling Functions" then 2 else if g = "Total Marketing Functions" then 3 else if g = "Research & Development" then 4 else if g = "Total G&A Functions" then 5 else 6, Int64.Type),
				    #"Pais Overview Agregado" = Table.AddColumn(#"Orden Grupo Agregado", "País Overview", each let c = [Country] in if c = "Chile" or c = "Peru" then "Chile & Perú" else if c = "Colombia" or c = "Panama" then "Colombia & Panamá" else if c = "Sin Datos" then "Global" else c, type text),
				    #"Orden Pais Agregado" = Table.AddColumn(#"Pais Overview Agregado", "Orden País", each let p = [País Overview] in if p = "Argentina" then 1 else if p = "Brazil" then 2 else if p = "Mexico" then 3 else if p = "Chile & Perú" then 4 else if p = "Colombia & Panamá" then 5 else if p = "Global" then 6 else 9, Int64.Type)
				in
				    #"Orden Pais Agregado"
				```

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

