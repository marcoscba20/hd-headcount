	/// Código numérico de 3 dígitos de la entidad legal, extraído de "Legal Employer Name". Clave de cruce contra el archivo Manual.
	column 'Código Entidad' = LEFT ( 'Excel HC Oracle'[Legal Employer Name], 3 )
