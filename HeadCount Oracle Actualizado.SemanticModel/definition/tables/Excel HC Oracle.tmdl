	column 'Rango Antigüedad' =
			SWITCH(
			    TRUE(),
			    'Excel HC Oracle'[Antigüedad (años)] < 1, "< 1 año",
			    'Excel HC Oracle'[Antigüedad (años)] < 3, "1 a 3 años",
			    'Excel HC Oracle'[Antigüedad (años)] < 5, "3 a 5 años",
			    'Excel HC Oracle'[Antigüedad (años)] < 10, "5 a 10 años",
			    'Excel HC Oracle'[Antigüedad (años)] < 20, "10 a 20 años",
			    "20+ años"
			)
		dataType: string
		lineageTag: 20679d22-1144-45c8-8f7e-3201c0b01369
		summarizeBy: none
		sortByColumn: 'Rango Antigüedad Orden'

		annotation SummarizationSetBy = Automatic

	column 'Rango Antigüedad Orden' =
			SWITCH(
			    TRUE(),
			    'Excel HC Oracle'[Antigüedad (años)] < 1, 1,
			    'Excel HC Oracle'[Antigüedad (años)] < 3, 2,
			    'Excel HC Oracle'[Antigüedad (años)] < 5, 3,
			    'Excel HC Oracle'[Antigüedad (años)] < 10, 4,
			    'Excel HC Oracle'[Antigüedad (años)] < 20, 5,
			    6
			)
		dataType: int64
		lineageTag: f60d5954-c8b1-48a4-aae5-94eee0df35f0
		summarizeBy: none

		annotation SummarizationSetBy = User

