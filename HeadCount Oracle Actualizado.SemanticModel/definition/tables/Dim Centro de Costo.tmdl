/// Centros de costo presentes en Oracle (Local Cost Center) y/o en el archivo Manual. Relacionada con Asignaciones y HC Manual LATAM. OJO: Oracle pobla Local Cost Center en una minoría de registros, así que la mayoría figura como "Solo Manual".
table 'Dim Centro de Costo'
	lineageTag: ca584c49-2dcc-48a8-952a-bfb492b5e371

	/// HC activo de Oracle para el centro de costo seleccionado.
	measure 'HC Oracle x CC' = CALCULATE ( [HC Activo], KEEPFILTERS ( NOT ISBLANK ( 'Dim Centro de Costo'[ID Centro de Costo] ) ) )
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: 278d0696-f35c-4499-8031-1b55bcf18a67

	/// HC del archivo Manual (último snapshot) para el centro de costo seleccionado.
	measure 'HC Manual x CC' = CALCULATE ( [HC Manual], KEEPFILTERS ( NOT ISBLANK ( 'Dim Centro de Costo'[ID Centro de Costo] ) ) )
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: 9eff64ef-bb14-4c05-bdc7-76453ccd862c

	measure 'Δ CC (Oracle - Manual)' = [HC Oracle x CC] - [HC Manual x CC]
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: f2054934-54cd-4262-8fa5-e55450d5604d

	/// Indica si el código de centro de costo existe en los dos orígenes o en uno solo.
	measure 'Estado Cruce CC' =
			VAR O = [HC Oracle x CC]
			VAR M = [HC Manual x CC]
			RETURN
			    SWITCH (
			        TRUE (),
			        O > 0 && M > 0, "En ambos",
			        O > 0, "Solo Oracle",
			        M > 0, "Solo Manual",
			        "—"
			    )
		displayFolder: 10 · Comparativo Oracle vs Manual
		lineageTag: b9d66f5e-3829-41b4-a42b-671f750e4665

	column 'ID Centro de Costo'
		dataType: string
		lineageTag: c4f25948-f90c-4a0d-a187-e229875718fa
		summarizeBy: none
		sourceColumn: ID Centro de Costo

		annotation SummarizationSetBy = Automatic

	partition 'Dim Centro de Costo' = m
		mode: import
		source =
				let
				    Limpiar = (t as table, c as text) as table => Table.Distinct(Table.SelectRows(Table.TransformColumns(t, {{c, each if _ = null then null else Text.Trim(Text.From(_)), type text}}), each Record.Field(_, c) <> null and not List.Contains({"", "Sin", "Sin Datos", "0"}, Record.Field(_, c))), {c, Comparer.OrdinalIgnoreCase}),
				    Ora = Table.RenameColumns(Table.SelectColumns(#"Oracle Base", {"Local Cost Center"}), {{"Local Cost Center", "ID Centro de Costo"}}),
				    Man = Table.SelectColumns(#"HC Manual LATAM", {"ID Centro de Costo"}),
				    Final = Limpiar(Table.Combine({Ora, Man}), "ID Centro de Costo")
				in
				    Final

	annotation PBI_ResultType = Table

