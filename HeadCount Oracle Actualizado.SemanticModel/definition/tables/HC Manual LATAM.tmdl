/// Snapshot manual de headcount: último corte (Fecha Snapshot más reciente) del archivo HeadCount Manual LATAM.xlsx, hoja "2026". Comparte con Asignaciones las dimensiones Entidad Legal, Centro de Costo y Type (hoja Data Quality).
table 'HC Manual LATAM'
	lineageTag: 3f8c1a92-6d47-4b05-9e21-7c4a5b8de013

	/// Headcount del archivo manual al último snapshot. Cuenta solo las personas con ACT/OFF = "ACT". Zone y País Overview se filtran desde los slicers de la página.
	/// Fecha del snapshot del archivo manual (mmm-yyyy), para títulos.
	measure 'Fecha Snapshot Manual' = FORMAT ( MAX ( 'HC Manual LATAM'[Fecha Snapshot] ), "mmm-yyyy" )
		displayFolder: 09 · HeadCount Manual (Excel)
		lineageTag: f65797d3-049e-4b71-b131-682584a0cead

	measure 'HC Manual' =
			CALCULATE (
			    COUNTROWS ( 'HC Manual LATAM' ),
			    'HC Manual LATAM'[ACT/OFF] = "ACT"
			)
		formatString: #,##0
		displayFolder: 09 · HeadCount Manual (Excel)
		lineageTag: 5a1e7c33-9b28-4f6a-8c05-1d3e6f2a9b74

