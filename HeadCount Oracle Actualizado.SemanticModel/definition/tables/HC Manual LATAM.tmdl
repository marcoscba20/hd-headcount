	/// Código de 3 dígitos de la entidad legal. Une con Dim Entidad Legal.
	column 'Código Entidad'
		dataType: string
		lineageTag: f221b6b4-65e5-43ee-8ca2-13f5d655264d
		summarizeBy: none
		sourceColumn: Código Entidad

		annotation SummarizationSetBy = Automatic

	partition 'HC Manual LATAM' = m
		mode: import
		source = ```
				let
				    // 1. BEST PRACTICE & CLOUD: Envolvemos la carga en un try. 
				    RutaArchivo = "C:\Users\Marcos\OneDrive - hdlaoti\People LATAM - Documentos\Área de Trabajo - Marcos\Modelos de Datos Power BI\HeadCount Oracle\HeadCount Manual LATAM.xlsx",
				    ArchivoBinario = try File.Contents(RutaArchivo) otherwise null,
				
				    // Si el archivo falla o no existe, devolvemos una tabla vacía para no romper el modelo.
				    Origen = if ArchivoBinario = null then #table({"Error"}, {{"Archivo no encontrado"}}) else Excel.Workbook(ArchivoBinario, null, true),
				
				    // 2. NAVEGACIÓN SEGURA
				    ExisteHoja = try Origen{[Item = "2026", Kind = "Sheet"]}[Data] otherwise #table({}, {}),
				
				    // 3. SELECCIÓN DE COLUMNAS
				    ColumnasRequeridas = {"Column1", "Column2", "Column4", "Column5", "Column7", "Column9", "Column11", "Column12", "Column13", "Column14", "Column15", "Column16", "Column17", "Column18", "Column19", "Column37", "Column38", "Column39", "Column43", "Column44", "Column46", "Column47", "Column48", "Column49", "Column50", "Column53", "Column65", "Column66"},
				    #"Columnas elegidas" = try Table.SelectColumns(ExisteHoja, ColumnasRequeridas, MissingField.UseNull) otherwise #table(ColumnasRequeridas, {}),
				
				    // --- NUEVO CORTAFUEGOS DE ERRORES NATIVOS ---
				    // Generamos dinámicamente una lista de reemplazo: {{"Col1", null}, {"Col2", null}...}
				    // Esto plancha cualquier #N/A, #REF!, o #VALOR! nativo de Excel a null antes de que rompa la query.
				    ListaReemplazoErrores = List.Transform(Table.ColumnNames(#"Columnas elegidas"), each {_, null}),
				    #"Errores Eliminados" = Table.ReplaceErrorValues(#"Columnas elegidas", ListaReemplazoErrores),
				
				    // 4. RENOMBRADO SEGURO
				    CambiosNombres = {{"Column1", "Fecha Snapshot"}, {"Column2", "País Código"}, {"Column4", "ID Nacional"}, {"Column5", "Primer Nombre"}, {"Column7", "Primer Apellido"}, {"Column9", "Género"}, {"Column11", "Fecha Nacimiento"}, {"Column12", "Fecha Contratación"}, {"Column13", "Entidad Legal"}, {"Column14", "Título de Cargo Local"}, {"Column15", "Tipo de Contrato"}, {"Column16", "Correo de Trabajo"}, {"Column17", "ID Centro de Costo"}, {"Column18", "Centro de Costo"}, {"Column19", "Tipo de Jornada"}, {"Column37", "Depto"}, {"Column38", "Sub-Depto"}, {"Column39", "Jefe Directo"}, {"Column43", "Type Adjusted"}, {"Column44", "Function Adjusted"}, {"Column46", "BU Adjusted"}, {"Column47", "ACT/OFF"}, {"Column48", "Fecha Salida"}, {"Column49", "Zone"}, {"Column50", "Grade"}, {"Column53", "Level"}, {"Column65", "Negocio"}, {"Column66", "Oracle ID"}},
				    #"Columnas renombradas" = Table.RenameColumns(#"Errores Eliminados", CambiosNombres, MissingField.Ignore),
				    
				    // 5. FILTRADO SEGURO: Ignora errores si la celda venía con #N/A.
				    FechasSnapshot = List.RemoveNulls(List.Transform(Table.Column(#"Columnas renombradas", "Fecha Snapshot"), each try Date.From(_) otherwise null)),
				    UltimoSnapshot = List.Max(FechasSnapshot),
				    #"Ultimo Snapshot" = Table.SelectRows(#"Columnas renombradas", each (try Date.From(Record.FieldOrDefault(_, "Fecha Snapshot", null)) = UltimoSnapshot otherwise false)),
				
				    // --- INICIO DEL BLINDAJE EXTREMO ---
				    // Funciones internas para limpieza absoluta de Errores, Nulls y Textos "#N/A"
				    LimpiarTexto = (v) => 
				        let 
				            IntentarTexto = try Text.Trim(Text.From(v)) otherwise "0",
				            Resultado = if IntentarTexto = null or IntentarTexto = "" or IntentarTexto = "#N/A" or IntentarTexto = "#N/D" then "0" else IntentarTexto
				        in Resultado,
				        
				    LimpiarFecha = (v) => 
				        let 
				            IntentarFecha = try Date.From(v) otherwise #date(1900, 1, 1),
				            // Si venía un texto "#N/A", el try de arriba falla y devuelve 1900-01-01. Solo cubrimos si llega nulo explícito:
				            Resultado = if v = null then #date(1900, 1, 1) else IntentarFecha
				        in Resultado,
				
				    ColumnasActuales = Table.ColumnNames(#"Ultimo Snapshot"),
				    ColsFechas = List.Intersect({{"Fecha Snapshot", "Fecha Nacimiento", "Fecha Contratación", "Fecha Salida"}, ColumnasActuales}),
				    ColsTextosYNumeros = List.Difference(ColumnasActuales, ColsFechas),
				
				    #"Blindaje Fechas" = Table.TransformColumns(#"Ultimo Snapshot", List.Transform(ColsFechas, each {_, LimpiarFecha, type date}), null, MissingField.Ignore),
				    // Al forzar todo lo demás a text con "0", blindas el modelo para que las medidas DAX o relaciones no se rompan por type mismatch.
				    #"Blindaje Textos" = Table.TransformColumns(#"Blindaje Fechas", List.Transform(ColsTextosYNumeros, each {_, LimpiarTexto, type text}), null, MissingField.Ignore),
				    // --- FIN DEL BLINDAJE EXTREMO ---
				
				    // 6. NORMALIZACIÓN SEGURA
				    #"Zone Normalizada" = Table.TransformColumns(#"Blindaje Textos", {{"Zone", each try Text.Upper(_) otherwise "0", type text}}, null, MissingField.Ignore),
				
				    // 7. AGRUPACIONES (Ya estaban bien estructuradas, solo mantenemos la consistencia)
				    #"Pais Overview Agregado" = Table.AddColumn(#"Zone Normalizada", "País Overview", each 
				        let bu = Record.FieldOrDefault(_, "BU Adjusted", "0") in
				        if List.Contains({"270 - HD Brazil WCP/AP Components", "271 - HD Toldos Do Brasil Ltda", "272 - Persianas en Casa Ltda", "274 - Elubel Industria e Comercio Ltda", "270 - HD Brazil"}, bu) then "Brazil"
				        else if List.Contains({"503 - HD Chile", "280 - Persianas Andina Ltda.", "TopRoller", "260 - HD Peru"}, bu) then "Chile & Perú"
				        else if bu = "502 - HD Mexico" then "Mexico"
				        else if List.Contains({"230 - HD Colombia", "231 - HD Colombia", "Panama"}, bu) then "Colombia & Panamá"
				        else if bu = "285 - HD Argentina" then "Argentina"
				        else if bu = "HD LAO" then "Corporate Latam"
				        else "Sin Definir", type text),
				
				    #"Orden Pais Agregado" = Table.AddColumn(#"Pais Overview Agregado", "Orden País", each 
				        let p = Record.FieldOrDefault(_, "País Overview", "0") in
				        if p = "Argentina" then 1
				        else if p = "Brazil" then 2
				        else if p = "Mexico" then 3
				        else if p = "Chile & Perú" then 4
				        else if p = "Colombia & Panamá" then 5
				        else if p = "Corporate Latam" then 6
				        else 9, Int64.Type),
				
				    #"Grupo Funcional Agregado" = Table.AddColumn(#"Orden Pais Agregado", "Grupo Funcional", each 
				        let f = Record.FieldOrDefault(_, "Function Adjusted", "0") in
				        if List.Contains({"DL", "IL", "OH", "Aprendiz"}, f) then "Total COGS Functions"
				        else if f = "Selling" then "Total Selling Functions"
				        else if f = "Marketing" then "Total Marketing Functions"
				        else if f = "Research & Development" then "Research & Development"
				        else if f = "General & Administrative" then "Total G&A Functions"
				        else "Sin Definir", type text),
				
				    #"Orden Grupo Agregado" = Table.AddColumn(#"Grupo Funcional Agregado", "Orden Grupo Funcional", each 
				        let g = Record.FieldOrDefault(_, "Grupo Funcional", "0") in
				        if g = "Total COGS Functions" then 1
				        else if g = "Total Selling Functions" then 2
				        else if g = "Total Marketing Functions" then 3
				        else if g = "Research & Development" then 4
				        else if g = "Total G&A Functions" then 5
				        else 6, Int64.Type),
				    // Código de 3 dígitos de la entidad legal. "TopRoller" y "Panama" no traen código: se mapean a mano contra Oracle (283 y 241).
				    #"Codigo Entidad" = Table.AddColumn(#"Orden Grupo Agregado", "Código Entidad", each let e = Text.From([Entidad Legal]) in if e = "TopRoller" then "283" else if e = "Panama" then "241" else Text.Start(e, 3), type text)
				in
				    #"Codigo Entidad"
				```

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Exception

