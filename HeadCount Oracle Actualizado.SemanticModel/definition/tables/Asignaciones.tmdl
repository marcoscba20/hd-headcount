	partition Asignaciones = m
		mode: import
		source =
				let
				    Base = #"Oracle Base",
				    // Los atributos fijos de la persona viven en Dim Persona
				    SinPersona = Table.RemoveColumns(Base, {"National ID", "Display Name", "Business Unit Name", "Legal Employer Name", "Country Code", "Country_1", "Legislation Code", "Work Email", "Person Gender", "Person Date of Birth", "Ámbito", "Manager Type", "E-Mail Address", "Manager Job Name", "Position Code", "Parent Manager 01 Work Email", "Parent Manager 01 Person Number", "Parent Manager 01 Name", "Parent Manager 02 Person Number", "Parent Manager 02 Name", "Parent Manager 03 Person Number", "Parent Manager 03 Name", "Parent Manager 04 Person Number", "Parent Manager 04 Name", "Parent Manager 05 Person Number", "Parent Manager 05 Name", "Parent Manager 06 Person Number", "Parent Manager 06 Name", "Parent Manager 07 Person Number", "Parent Manager 07 Name", "Parent Manager 08 Person Number", "Parent Manager 08 Name"})
				in
				    SinPersona

	annotation PBI_ResultType = Table

