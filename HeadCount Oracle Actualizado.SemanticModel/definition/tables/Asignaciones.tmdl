	/// Nivel jerárquico del puesto según Oracle.
	column Level
		dataType: string
		lineageTag: 1b84d7e0-5c39-4a26-b7f4-90e2d5138c67
		summarizeBy: none
		sourceColumn: Level

		annotation SummarizationSetBy = Automatic

	/// Nivel jerárquico legible: L1 (más alto) a L9. "Sin Nivel" para el valor 0 de Oracle, mayormente mano de obra directa.
	column Nivel =
			VAR L = 'Asignaciones'[Level]
			RETURN
			    IF ( L IN { "0", "", "Sin Datos" } || ISBLANK ( L ), "Sin Nivel", "L" & L )
		dataType: string
		lineageTag: 8c25f19b-6a47-4e03-91d8-b5704e2fa63c
		summarizeBy: none
		sortByColumn: 'Nivel Orden'

		annotation SummarizationSetBy = Automatic

	/// Orden de Nivel: 1..9 según el nivel; 99 para "Sin Nivel", que queda al final.
	column 'Nivel Orden' =
			VAR L = 'Asignaciones'[Level]
			RETURN
			    IF (
			        L IN { "0", "", "Sin Datos" } || ISBLANK ( L ),
			        99,
			        IFERROR ( VALUE ( L ), 99 )
			    )
		dataType: int64
		lineageTag: 5f70b3e8-2c94-4d61-a375-e8916bc042d5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Agrupación de Grade que replica el corte "G8+" de la presentación People Excellence.
	column 'Grade Grupo' =
			SWITCH(
			    TRUE(),
			    ISBLANK ( 'Asignaciones'[Grade Nº] ) || 'Asignaciones'[Grade Nº] = 99, "Sin Grade",
			    'Asignaciones'[Grade Nº] >= 8, "G8+",
			    "G1-G7"
			)
		dataType: string
		lineageTag: 1e64a95c-8b30-42f7-9d58-c073a2e61b49
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Esquema de bonus por objetivos: "Con MBO" / "Sin MBO" / "No Aplica" (campo vacío en Oracle = la persona no participa del esquema). OJO: es una FOTO del estado actual, no un histórico. Al cruzarla con [Bajas] se segmenta por el esquema vigente al momento del export, no al momento de la baja.
	column 'Esquema MBO' =
			SWITCH (
			    'Asignaciones'[MBO Bonus Scheme],
			    "Yes", "Con MBO",
			    "No", "Sin MBO",
			    "No Aplica"
			)
		dataType: string
		lineageTag: 4e5f6071-0003-4d40-9004-dd4400000003
		summarizeBy: none
		sortByColumn: 'Orden Esquema MBO'

		annotation SummarizationSetBy = Automatic

	/// Orden de [Esquema MBO]: 1 Con MBO, 2 Sin MBO, 3 No Aplica.
	column 'Orden Esquema MBO' = SWITCH ( 'Asignaciones'[MBO Bonus Scheme], "Yes", 1, "No", 2, 3 )
		dataType: int64
		lineageTag: 4e5f6071-0004-4d40-9004-dd4400000004
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Elegibilidad de Bonus Swap: "Elegible" / "No Elegible" / "No Aplica". Igual que [Esquema MBO], es una foto del estado actual y no un histórico.
	column 'Bonus Swap' =
			SWITCH (
			    'Asignaciones'[Bonus Swap Eligible],
			    "Yes", "Elegible",
			    "No", "No Elegible",
			    "No Aplica"
			)
		dataType: string
		lineageTag: 4e5f6071-0005-4d40-9004-dd4400000005
		summarizeBy: none
		sortByColumn: 'Orden Bonus Swap'

		annotation SummarizationSetBy = Automatic

	/// Orden de [Bonus Swap]: 1 Elegible, 2 No Elegible, 3 No Aplica.
	column 'Orden Bonus Swap' = SWITCH ( 'Asignaciones'[Bonus Swap Eligible], "Yes", 1, "No", 2, 3 )
		dataType: int64
		lineageTag: 4e5f6071-0006-4d40-9004-dd4400000006
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

