/// Asignaciones del export semanal de Oracle (una fila por asignación). Guarda lo que cambia entre asignaciones de una misma persona (área, puesto, grade, nivel, país, función, cross charge, MBO, fechas y estado). Lo fijo de la persona está en Dim Persona. Calendario NO se relaciona con esta tabla: las medidas de headcount leen el rango de Calendario y filtran fechas de ingreso/baja ellas mismas.
table Asignaciones
	lineageTag: bf125006-48c8-47d6-8c24-a4fa9ce54e0c

	/// Personas distintas, NO filas. El export trae una fila por asignación: 2464 filas para 1904 personas. Por eso cuenta Person Number distintos y el total de una matriz no es la suma de sus filas (una persona con dos entidades legales aparece en ambas y se cuenta una sola vez en el total).
	measure Dotación = DISTINCTCOUNT('Asignaciones'[Person Number])
		formatString: #,##0
		displayFolder: 01 · Dotación
		lineageTag: 6d30c71e-e338-444c-8dda-f59e08f2955a

	measure 'Ingresos (Altas)' = [Dotación]
		formatString: #,##0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: a6be226e-c7c7-44dc-9b37-9ac34cb5710d

	/// Promedio POR PERSONA, no por fila: el export trae una fila por asignación, así que se colapsa cada Person Number antes de promediar.
	measure 'Antigüedad Promedio (años)' =
			AVERAGEX (
			    VALUES ( 'Asignaciones'[Person Number] ),
			    CALCULATE ( MAX ( 'Asignaciones'[Antigüedad (años)] ) )
			)
		formatString: #,##0.0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: a2541540-e629-4031-acef-eef302d01fe9

	/// Mediana POR PERSONA. Ver la nota de [Antigüedad Promedio (años)].
	measure 'Antigüedad Mediana (años)' =
			MEDIANX (
			    VALUES ( 'Asignaciones'[Person Number] ),
			    CALCULATE ( MAX ( 'Asignaciones'[Antigüedad (años)] ) )
			)
		formatString: #,##0.0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 576bd567-25f9-4dc5-aef1-fa2287ff4178

	measure 'Nº Entidades Legales' =
			VAR Personas = VALUES ( 'Asignaciones'[Person Number] )
			RETURN
			    CALCULATE ( DISTINCTCOUNT ( 'Dim Persona'[Entidad Legal] ), TREATAS ( Personas, 'Dim Persona'[Person Number] ) )
		formatString: 0
		displayFolder: 05 · Conteos y Estructura
		lineageTag: 5f4c3c7d-e318-411a-aa5f-248db19aadee

	measure 'Nº Países' = DISTINCTCOUNT('Asignaciones'[Country])
		formatString: 0
		displayFolder: 05 · Conteos y Estructura
		lineageTag: 87e41fa7-84a9-4a30-94f2-229132f420ba

	measure 'Nº Funciones' = DISTINCTCOUNT('Asignaciones'[EPM Main Function Name])
		formatString: 0
		displayFolder: 05 · Conteos y Estructura
		lineageTag: 7c62a8fa-ebc2-4b9c-99a7-bb2d7ed10347

	measure '% del Total Dotación' = DIVIDE([Dotación], CALCULATE([Dotación], ALLSELECTED('Asignaciones')))
		formatString: 0.0%
		displayFolder: 01 · Dotación
		lineageTag: ac9f29e0-685e-4fb7-957b-d0a147f9f45d

	measure 'Nuevas Incorporaciones (<1 año)' = CALCULATE([Dotación], 'Asignaciones'[Antigüedad (años)] < 1)
		formatString: #,##0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 8dfebb0a-9bed-4d91-a281-0b7f231c2690

	measure '% Nuevas Incorporaciones' = DIVIDE([Nuevas Incorporaciones (<1 año)], [Dotación])
		formatString: 0.0%
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 4fca5228-3377-4b6d-b36e-3187891951b3

	measure 'Dotación +10 años' = CALCULATE([Dotación], 'Asignaciones'[Antigüedad (años)] >= 10)
		formatString: #,##0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 420fc517-0386-4cb4-a5d9-9712767cdb2b

	measure '% Antigüedad +10 años' = DIVIDE([Dotación +10 años], [Dotación])
		formatString: 0.0%
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 97b5e777-f4f7-4dcc-a451-ada778c8259c

	measure 'Dotación Cross-Entity' = CALCULATE([Dotación], NOT 'Asignaciones'[Cross Charge Entity Name] IN {"None", "Sin Datos"})
		formatString: #,##0
		displayFolder: 06 · Costo y Cross-Entity
		lineageTag: e0fb8d29-fc2c-4bd4-a180-44fe9208af4c

	measure '% Cross-Entity' = DIVIDE([Dotación Cross-Entity], [Dotación])
		formatString: 0.0%
		displayFolder: 06 · Costo y Cross-Entity
		lineageTag: 538dcfc4-405d-4b9b-a1e5-3259745d2fb5

	measure 'Dotación Directa (COGS)' = CALCULATE([Dotación], 'Asignaciones'[Labor Type] = "Direct")
		formatString: #,##0
		displayFolder: 06 · Costo y Cross-Entity
		lineageTag: ee7ddc27-5c5e-4f2b-959e-c7c03e530e01

	measure '% Mano de Obra Directa' = DIVIDE([Dotación Directa (COGS)], [Dotación])
		formatString: 0.0%
		displayFolder: 06 · Costo y Cross-Entity
		lineageTag: 1dc406a7-cd16-4efe-b034-a0878e51a124

	measure 'Ingresos Año Actual' = CALCULATE([Dotación], 'Asignaciones'[Año Ingreso] = YEAR(TODAY()))
		formatString: #,##0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 6f4fb49c-8eae-4a74-90ec-937d891ca356

	measure 'Ingresos Año Anterior' = CALCULATE([Dotación], 'Asignaciones'[Año Ingreso] = YEAR(TODAY()) - 1)
		formatString: #,##0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 60d4a335-be6d-4d2b-a0d5-1f144ff7e8b7

	measure 'Var. Ingresos vs Año Anterior' = [Ingresos Año Actual] - [Ingresos Año Anterior]
		formatString: +#,##0;-#,##0;0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: 0b46bb8c-8cea-4c93-b04b-9dc368581338

	/// Dotación activa (ACTIVE = 1). Base de headcount para todas las hojas.
	measure 'HC Activo' = CALCULATE([Dotación], 'Asignaciones'[ACTIVE] = "1")
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 9c95b852-c2f8-4e05-8fb9-3b3873998c98

	/// Dotación inactiva / dada de baja (ACTIVE = 0).
	measure 'HC Inactivo' = CALCULATE([Dotación], 'Asignaciones'[ACTIVE] = "0")
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 5192e2d1-6e1d-4937-94b3-b52ef4c6ba50

	/// Porcentaje de la dotación que está activa.
	measure '% HC Activo' = DIVIDE([HC Activo], [Dotación])
		formatString: 0.0%
		displayFolder: 03 · Headcount Activo
		lineageTag: 9652d502-764f-4a07-83d3-439061047d64

	/// Activos al inicio del período seleccionado (día previo al primer día del rango del Calendario).
	measure 'HC Activo Inicio' =
			VAR D = MIN ( 'Calendario'[Date] ) - 1
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 25bfebc9-b340-404d-868e-3bb479b8dec5

	/// Activos al fin del período seleccionado (último día del rango del Calendario).
	measure 'HC Activo Fin' =
			VAR D = MAX ( 'Calendario'[Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: ea6d0f95-f846-49ec-af2e-bacf289553af

	/// Promedio de activos del período: (inicio + fin) / 2. Denominador de las tasas de rotación.
	measure 'HC Activo Promedio' = DIVIDE([HC Activo Inicio] + [HC Activo Fin], 2)
		formatString: #,##0.0
		displayFolder: 03 · Headcount Activo
		lineageTag: a9cbb2cd-3fb0-43cd-a50b-d3da0e2f2e41

	/// Egresos reales del período: personas que dejan de tener asignaciones activas. Una asignación cerrada que se reemplaza por otra (reasignación) no cuenta.
	measure Bajas =
			VAR Ini = MIN ( 'Calendario'[Date] )
			VAR Fin = MAX ( 'Calendario'[Date] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Fact Movimientos' ),
			        'Fact Movimientos'[Tipo] = "Baja",
			        'Fact Movimientos'[Fecha] >= Ini,
			        'Fact Movimientos'[Fecha] <= Fin
			    )
		formatString: #,##0
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: b3cbe3a2-e363-4cdb-9904-1da140c16fa4

	/// Bajas voluntarias (renuncias) del período.
	measure 'Bajas Voluntarias' = CALCULATE ( [Bajas], 'Fact Movimientos'[Action Name] = "Voluntary Termination" )
		formatString: #,##0
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 3779a3c8-6b02-44f1-b5bf-f8700c69bb46

	/// Bajas involuntarias (despidos / fin de contrato) del período.
	measure 'Bajas Involuntarias' = CALCULATE ( [Bajas], 'Fact Movimientos'[Action Name] = "Involuntary Termination" )
		formatString: #,##0
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 13f0272e-03da-4a34-a064-35353fe3d597

	/// Asignaciones cerradas en el período que NO son egreso porque la persona siguió activa en otra asignación. Diferencia entre el conteo por fila de Oracle y [Bajas].
	measure 'Val · Reasignaciones Excluidas' =
			VAR Ini = MIN ( 'Calendario'[Date] )
			VAR Fin = MAX ( 'Calendario'[Date] )
			VAR CerradasEnPeriodo =
			    CALCULATE ( COUNTROWS ( 'Asignaciones' ), 'Asignaciones'[Termination Date] >= Ini, 'Asignaciones'[Termination Date] <= Fin )
			RETURN
			    CerradasEnPeriodo - [Bajas]
		formatString: #,##0
		displayFolder: 08 · Validación (Data Quality)
		lineageTag: 15603ef6-69a2-4ef5-bb30-0f48c433b810

	/// Altas reales del período: personas que pasan de no tener ninguna asignación activa a tener una. Una reasignación (se cierra una asignación y se abre otra) no cuenta.
	measure Altas =
			VAR Ini = MIN ( 'Calendario'[Date] )
			VAR Fin = MAX ( 'Calendario'[Date] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Fact Movimientos' ),
			        'Fact Movimientos'[Tipo] = "Alta",
			        'Fact Movimientos'[Fecha] >= Ini,
			        'Fact Movimientos'[Fecha] <= Fin
			    )
		formatString: #,##0
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 4f8e6383-4327-4efa-9994-91d5fe9dc06f

	/// Tasa de rotación total del período = Bajas / Activos promedio.
	measure 'Rotación %' = DIVIDE([Bajas], [HC Activo Promedio])
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 92b6ddf9-4947-4134-acb0-20e5ccded9ba

	/// Tasa de rotación voluntaria = Bajas voluntarias / Activos promedio.
	measure 'Rotación Voluntaria %' = DIVIDE([Bajas Voluntarias], [HC Activo Promedio])
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: be46b566-2e04-4ea9-b61a-2c6fe601befd

	/// Tasa de rotación involuntaria = Bajas involuntarias / Activos promedio.
	measure 'Rotación Involuntaria %' = DIVIDE([Bajas Involuntarias], [HC Activo Promedio])
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: b00aad93-99f9-43c9-b71d-37eb00d3a5e9

	/// Tasa de contratación del período = Altas / Activos promedio.
	measure 'Tasa Contratación %' = DIVIDE([Altas], [HC Activo Promedio])
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 80c3bbb3-02b1-4e9f-910e-53ba9fba4e60

	/// Variación neta de dotación en el período = Altas - Bajas.
	measure 'Crecimiento Neto' = [Altas] - [Bajas]
		formatString: +#,##0;-#,##0;0
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: c6f923eb-f3c8-4961-947a-8ef874217f98

	/// Crecimiento neto como % de los activos al inicio del período.
	measure '% Crecimiento Neto' = DIVIDE([Crecimiento Neto], [HC Activo Inicio])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: b724f629-af4b-4f82-82e9-c8096e2f1835

	/// Antigüedad promedio limitada a empleados activos.
	measure 'Antigüedad Promedio Activos' = CALCULATE([Antigüedad Promedio (años)], 'Asignaciones'[ACTIVE] = "1")
		formatString: #,##0.0
		displayFolder: 02 · Ingresos y Antigüedad
		lineageTag: da7b15e7-570b-4fb9-ae0a-996a69b4962c

	/// Grade numérico promedio (proxy de nivel salarial). Eje X del dispersión Grade vs Antigüedad.
	/// Grade promedio POR PERSONA. Colapsa con MIN, así una persona con una asignación sin grade (sentinel 99) toma su grade real. Si todas sus filas son 99, sigue pesando 99.
	measure 'Grade Promedio' =
			AVERAGEX (
			    VALUES ( 'Asignaciones'[Person Number] ),
			    CALCULATE ( MIN ( 'Asignaciones'[Grade Nº] ) )
			)
		formatString: #,##0.0
		displayFolder: 07 · Grades
		lineageTag: 8dfee0df-9b5b-4178-993b-59a4afb40489

	/// Cantidad de grades distintos presentes en el contexto.
	measure 'Nº Grades' = DISTINCTCOUNT('Asignaciones'[Grade Name])
		formatString: 0
		displayFolder: 07 · Grades
		lineageTag: f20c9356-dd61-4aac-9ef9-feb08f5f5bfe

	/// Activos a hoy (reconstrucción punto-en-tiempo). Ancla = TODAY(). Base de la hoja Overview.
	measure 'HC Activo Hoy' =
			VAR D = TODAY ()
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: a60b7c37-93f5-4985-bef6-017f3a71b46c

	/// Activos hace 1 mes (as-of EDATE(TODAY(),-1)).
	measure 'HC Activo Hace 1M' =
			VAR D = EDATE ( TODAY (), -1 )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 62ca01cd-7326-4c83-adbe-9b5b786c3cbf

	/// Activos hace 12 meses (as-of EDATE(TODAY(),-12)).
	measure 'HC Activo Hace 12M' =
			VAR D = EDATE ( TODAY (), -12 )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 921123ad-6942-472d-b12f-e3e89730e3d8

	/// Delta de activos vs mes anterior (unidades).
	measure 'Δ HC vs Mes Anterior' = [HC Activo Hoy] - [HC Activo Hace 1M]
		formatString: +#,##0;-#,##0;0
		displayFolder: 03 · Headcount Activo
		lineageTag: 7a1d6f3b-2c44-4e9a-8b11-501122aa0001

	/// Delta % de activos vs mes anterior.
	measure 'Δ% HC vs Mes Anterior' = DIVIDE([Δ HC vs Mes Anterior], [HC Activo Hace 1M])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 · Headcount Activo
		lineageTag: 7a1d6f3b-2c44-4e9a-8b11-501122aa0002

	/// Delta de activos vs año anterior (unidades).
	measure 'Δ HC vs Año Anterior' = [HC Activo Hoy] - [HC Activo Hace 12M]
		formatString: +#,##0;-#,##0;0
		displayFolder: 03 · Headcount Activo
		lineageTag: 7a1d6f3b-2c44-4e9a-8b11-501122aa0003

	/// Delta % de activos vs año anterior.
	measure 'Δ% HC vs Año Anterior' = DIVIDE([Δ HC vs Año Anterior], [HC Activo Hace 12M])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 · Headcount Activo
		lineageTag: 7a1d6f3b-2c44-4e9a-8b11-501122aa0004

	/// Registros de más respecto de personas únicas. > 0 indica Person Number duplicados.
	measure 'Person Number Duplicados' = COUNTROWS('Asignaciones') - DISTINCTCOUNT('Asignaciones'[Person Number])
		formatString: #,##0
		displayFolder: 08 · Validación (Data Quality)
		lineageTag: 1b2c3d4e-0002-4a10-9f01-aa1100000002

	/// Asignaciones cuya persona no tiene National ID en Oracle ("Sin Datos" o vacío).
	measure 'Registros sin National ID' =
			CALCULATE (
			    COUNTROWS ( 'Asignaciones' ),
			    KEEPFILTERS ( 'Dim Persona'[ID Nacional Oracle] IN { "Sin Datos", "" } )
			)
		formatString: #,##0
		displayFolder: 08 · Validación (Data Quality)
		lineageTag: 1b2c3d4e-0003-4a10-9f01-aa1100000003

	/// Registros activos sin código de centro de costo local en Oracle.
	measure 'Registros sin Centro de Costo' =
			CALCULATE (
			    [HC Activo],
			    'Asignaciones'[Local Cost Center] IN { "Sin Datos", "" }
			)
		formatString: #,##0
		displayFolder: 08 · Validación (Data Quality)
		lineageTag: 1b2c3d4e-0004-4a10-9f01-aa1100000004

	/// Cobertura del campo "Local Cost Center" en Oracle sobre el headcount activo.
	measure '% Registros con Centro de Costo' = DIVIDE ( [HC Activo] - [Registros sin Centro de Costo], [HC Activo] )
		formatString: 0.0%
		displayFolder: 08 · Validación (Data Quality)
		lineageTag: 1b2c3d4e-0005-4a10-9f01-aa1100000005

	/// Activos al 31-dic-2025 (cierre del año anterior). Equivale a la columna "2025 Actuals" del pilar Headcount del Excel Report Países.
	measure 'HC Actuals 2025' =
			VAR D = DATE ( 2025, 12, 31 )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0001-4b20-8e02-bb2200000001

	/// Activos al último cierre de mes (as-of EOMONTH(TODAY(),-1)). Corte punto-en-el-tiempo, no promedio.
	measure 'HC YTD Actuals' =
			VAR D = EOMONTH ( TODAY (), -1 )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0002-4b20-8e02-bb2200000002

	/// Activos al mismo cierre de mes del año anterior (as-of EDATE(EOMONTH(TODAY(),-1),-12)).
	measure 'HC YTD PY' =
			VAR D = EDATE ( EOMONTH ( TODAY (), -1 ), -12 )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0003-4b20-8e02-bb2200000003

	/// Diferencia entre los dos cortes YTD (actual vs año anterior), en unidades.
	measure 'Δ HC YTD vs PY' = [HC YTD Actuals] - [HC YTD PY]
		formatString: +#,##0;-#,##0;0
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0004-4b20-8e02-bb2200000004

	/// Fechas de corte efectivas de las columnas del pilar Headcount. Se usa como subtítulo de la matriz del Overview.
	measure 'Cortes Pilar Headcount' =
			VAR D = EOMONTH ( TODAY (), -1 )
			RETURN
			    "Actuals 2025: 31-dic-2025  ·  YTD Actuals: "
			        & FORMAT ( D, "dd-mmm-yyyy" )
			        & "  ·  YTD PY: "
			        & FORMAT ( EDATE ( D, -12 ), "dd-mmm-yyyy" )
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0005-4b20-8e02-bb2200000005

	/// Activos al cierre del período del contexto de 'Calendario', recortado al último mes COMPLETO: nunca informa un mes parcial. Es la medida para la EVOLUCIÓN mes a mes: poner 'Calendario'[Año-Mes] en el eje. El mes en curso y los futuros quedan en blanco a propósito; sin contexto de fecha devuelve el HC al cierre del mes anterior. Requiere que 'Calendario' no se relacione con Asignaciones.
	measure 'HC Activo PIT' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR D = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			RETURN
			    IF (
			        MIN ( 'Calendario'[Date] ) <= FinCerrado,
			        CALCULATE (
			            DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			            FILTER (
			                'Asignaciones',
			                'Asignaciones'[Enterprise Hire Date] <= D
			                    && (
			                        'Asignaciones'[Termination Date] > D
			                            || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                    )
			            )
			        )
			    )
		formatString: #,##0
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0006-4b20-8e02-bb2200000006

	/// Variación porcentual del HC point-in-time contra el mes anterior del mismo eje. Comparte el corte al último mes COMPLETO de [HC Activo PIT]: el mes previo se deriva de ese cierre recortado, no del último día del Calendario.
	measure 'Δ% HC PIT vs Mes Anterior' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR Fin = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			VAR Actual = [HC Activo PIT]
			VAR D = EOMONTH ( Fin, -1 )
			VAR Previo =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= D
			                && (
			                    'Asignaciones'[Termination Date] > D
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
			RETURN
			    DIVIDE ( Actual - Previo, Previo )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0007-4b20-8e02-bb2200000007

	/// Rotación del período llevada a base anual. Útil cuando el eje son meses sueltos: un 1,5% mensual se lee como 18% anual.
	measure 'Rotación % Anualizada' =
			VAR Meses =
			    DATEDIFF ( MIN ( 'Calendario'[Date] ), MAX ( 'Calendario'[Date] ), MONTH ) + 1
			RETURN
			    [Rotación %] * DIVIDE ( 12, Meses )
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 2c3d4e5f-0008-4b20-8e02-bb2200000008

	/// Rotación de los últimos 12 meses cerrados al final del período visible, recortado al último mes COMPLETO: nunca mide sobre un mes parcial. Suaviza el ruido de la serie mensual. El mes en curso y los futuros quedan en blanco a propósito; sin contexto de fecha devuelve el 12M móvil cerrado al mes anterior.
	measure 'Rotación % 12M Móvil' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR Fin = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			VAR Ini = EDATE ( Fin, -12 ) + 1
			VAR BajasTramo =
			    CALCULATE (
			        COUNTROWS ( 'Fact Movimientos' ),
			        'Fact Movimientos'[Tipo] = "Baja",
			        REMOVEFILTERS ( 'Calendario' ),
			        'Fact Movimientos'[Fecha] >= Ini,
			        'Fact Movimientos'[Fecha] <= Fin
			    )
			VAR HCIni =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= Ini - 1
			                && (
			                    'Asignaciones'[Termination Date] > Ini - 1
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
			VAR HCFin =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			        FILTER (
			            'Asignaciones',
			            'Asignaciones'[Enterprise Hire Date] <= Fin
			                && (
			                    'Asignaciones'[Termination Date] > Fin
			                        || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                )
			        )
			    )
			RETURN
			    IF (
			        MIN ( 'Calendario'[Date] ) <= FinCerrado,
			        DIVIDE ( BajasTramo + 0, DIVIDE ( HCIni + HCFin, 2 ) )
			    )
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 2c3d4e5f-0009-4b20-8e02-bb2200000009

	/// Bajas del período en los niveles ejecutivos L1 a L3. Equivale al KPI "L1-L3 TO" de la presentación People Excellence.
	measure 'Bajas L1-L3' = CALCULATE([Bajas], 'Asignaciones'[Nivel Orden] <= 3)
		formatString: #,##0
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 2c3d4e5f-0010-4b20-8e02-bb2200000010

	/// Rotación de niveles L1-L3 sobre el HC promedio de esos mismos niveles.
	measure 'Rotación % L1-L3' =
			DIVIDE (
			    [Bajas L1-L3],
			    CALCULATE ( [HC Activo Promedio], 'Asignaciones'[Nivel Orden] <= 3 )
			)
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 2c3d4e5f-0011-4b20-8e02-bb2200000011

	/// Rotación del segmento G8+ sobre el HC promedio de ese mismo segmento.
	measure 'Rotación % G8+' =
			DIVIDE (
			    CALCULATE ( [Bajas], 'Asignaciones'[Grade Grupo] = "G8+" ),
			    CALCULATE ( [HC Activo Promedio], 'Asignaciones'[Grade Grupo] = "G8+" )
			)
		formatString: 0.0%
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 2c3d4e5f-0012-4b20-8e02-bb2200000012

	/// Altas del período en el segmento G8+. Equivale al KPI "New Hires (# G8+)" de la presentación.
	measure 'Altas G8+' = CALCULATE([Altas], 'Asignaciones'[Grade Grupo] = "G8+")
		formatString: #,##0
		displayFolder: 04 · Rotación (Turnover)
		lineageTag: 2c3d4e5f-0013-4b20-8e02-bb2200000013

	/// Porcentaje de mujeres sobre el headcount activo. "Sin Dato" (~4 registros) queda fuera del numerador.
	measure '% Femenino' = DIVIDE ( CALCULATE ( [HC Activo], 'Dim Persona'[Género] = "Femenino" ), [HC Activo] )
		formatString: 0.0%
		displayFolder: 11 · Demografía
		lineageTag: 2c3d4e5f-0014-4b20-8e02-bb2200000014

	/// Porcentaje de varones sobre el headcount activo.
	measure '% Masculino' = DIVIDE ( CALCULATE ( [HC Activo], 'Dim Persona'[Género] = "Masculino" ), [HC Activo] )
		formatString: 0.0%
		displayFolder: 11 · Demografía
		lineageTag: 2c3d4e5f-0015-4b20-8e02-bb2200000015

	/// Edad promedio de los activos. Ignora los registros con fecha de nacimiento inválida.
	measure 'Edad Promedio' =
			VAR Activos = CALCULATETABLE ( VALUES ( 'Asignaciones'[Person Number] ), 'Asignaciones'[ACTIVE] = "1" )
			RETURN
			    CALCULATE ( AVERAGE ( 'Dim Persona'[Edad] ), TREATAS ( Activos, 'Dim Persona'[Person Number] ) )
		formatString: #,##0.0
		displayFolder: 11 · Demografía
		lineageTag: 2c3d4e5f-0016-4b20-8e02-bb2200000016

	/// Edad mediana de los activos. Menos sensible a outliers que el promedio.
	measure 'Edad Mediana' =
			VAR Activos = CALCULATETABLE ( VALUES ( 'Asignaciones'[Person Number] ), 'Asignaciones'[ACTIVE] = "1" )
			RETURN
			    CALCULATE ( MEDIAN ( 'Dim Persona'[Edad] ), TREATAS ( Activos, 'Dim Persona'[Person Number] ) )
		formatString: #,##0.0
		displayFolder: 11 · Demografía
		lineageTag: 2c3d4e5f-0017-4b20-8e02-bb2200000017

	/// Antigüedad mediana de los activos expresada en meses, como el KPI "Median Tenure (months)" de la presentación.
	measure 'Antigüedad Mediana (meses)' =
			CALCULATE (
			    MEDIANX (
			        VALUES ( 'Asignaciones'[Person Number] ),
			        CALCULATE ( MAX ( 'Asignaciones'[Antigüedad (años)] ) )
			    ),
			    'Asignaciones'[ACTIVE] = "1"
			) * 12
		formatString: #,##0
		displayFolder: 11 · Demografía
		lineageTag: 2c3d4e5f-0018-4b20-8e02-bb2200000018

	/// Participación de cada categoría sobre el headcount activo visible. Es el "% por Grade / género / antigüedad" del Overview.
	measure '% del Total HC Activo' = DIVIDE([HC Activo], CALCULATE([HC Activo], ALLSELECTED('Asignaciones')))
		formatString: 0.0%
		displayFolder: 03 · Headcount Activo
		lineageTag: 2c3d4e5f-0020-4b20-8e02-bb2200000020

	/// Cobertura del dato de edad: porcentaje de activos con fecha de nacimiento utilizable.
	measure '% Cobertura Edad' = DIVIDE ( CALCULATE ( [HC Activo], NOT ISBLANK ( 'Dim Persona'[Edad] ) ), [HC Activo] )
		formatString: 0.0%
		displayFolder: 11 · Demografía
		lineageTag: 2c3d4e5f-0019-4b20-8e02-bb2200000019

	/// VALIDACIÓN · Fecha de corte del stock inicial: el día ANTERIOR al primer día del período. [HC Activo Inicio] cuenta a esa fecha, no al primer día del período; es la confusión más habitual al auditar la rotación.
	measure 'Val · Corte HC Inicio' = FORMAT ( MIN ( 'Calendario'[Date] ) - 1, "dd-mmm-yyyy" )
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0001-4c30-9f03-cc3300000001

	/// VALIDACIÓN · Fecha de corte del stock final: último día del período seleccionado. Es la fecha exacta que usa [HC Activo Fin].
	measure 'Val · Corte HC Fin' = FORMAT ( MAX ( 'Calendario'[Date] ), "dd-mmm-yyyy" )
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0002-4c30-9f03-cc3300000002

	/// VALIDACIÓN · Días calendario que abarca el período seleccionado. Sirve para detectar que un filtro dejó una ventana más corta de la esperada.
	measure 'Val · Días del Período' = DATEDIFF ( MIN ( 'Calendario'[Date] ), MAX ( 'Calendario'[Date] ), DAY ) + 1
		formatString: #,##0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0003-4c30-9f03-cc3300000003

	/// VALIDACIÓN · Numerador de la rotación contando PERSONAS distintas. Debe coincidir con [Bajas], que cuenta FILAS. Si difiere, hay legajos repetidos en el export.
	measure 'Val · Bajas (personas únicas)' =
			VAR Ini = MIN ( 'Calendario'[Date] )
			VAR Fin = MAX ( 'Calendario'[Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Fact Movimientos'[Person Number] ),
			        'Fact Movimientos'[Tipo] = "Baja",
			        'Fact Movimientos'[Fecha] >= Ini,
			        'Fact Movimientos'[Fecha] <= Fin
			    )
		formatString: #,##0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0004-4c30-9f03-cc3300000004

	/// Personas con más de un egreso en el período (salieron, reingresaron y volvieron a salir).
	measure 'Val · Bajas Duplicadas' = [Bajas] - [Val · Bajas (personas únicas)]
		formatString: #,##0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0005-4c30-9f03-cc3300000005

	/// VALIDACIÓN · Dotación final deducida del movimiento del período: HC Inicio + Altas - Bajas. Se contrasta contra [HC Activo Fin], que se calcula de forma independiente.
	measure 'Val · HC Fin Teórico' = [HC Activo Inicio] + [Altas] - [Bajas]
		formatString: #,##0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0006-4c30-9f03-cc3300000006

	/// VALIDACIÓN · Diferencia entre el HC final real y el que surge del movimiento. Debe ser 0: si no lo es, hay altas o bajas que el export no refleja, o legajos contados dos veces.
	measure 'Val · Dif Conciliación' = [HC Activo Fin] - [Val · HC Fin Teórico]
		formatString: +#,##0;-#,##0;0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0007-4c30-9f03-cc3300000007

	/// VALIDACIÓN · Resultado en texto de la conciliación del movimiento de dotación.
	measure 'Val · Chequeo Conciliación' =
			VAR D = [Val · Dif Conciliación]
			RETURN
			    IF (
			        D = 0,
			        "OK · HC Inicio + Altas - Bajas = HC Fin",
			        "REVISAR · diferencia de " & FORMAT ( D, "#,##0" ) & " personas"
			    )
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0008-4c30-9f03-cc3300000008

	/// VALIDACIÓN · La cuenta de la rotación del período escrita con los números del contexto actual, para poder rehacerla a mano.
	measure 'Val · Fórmula Rotación' =
			VAR B = [Bajas] + 0
			VAR I = [HC Activo Inicio] + 0
			VAR F = [HC Activo Fin] + 0
			VAR P = DIVIDE ( I + F, 2 )
			RETURN
			    FORMAT ( B, "#,##0" ) & " bajas ÷ ( ( " & FORMAT ( I, "#,##0" ) & " + "
			        & FORMAT ( F, "#,##0" ) & " ) ÷ 2 = " & FORMAT ( P, "#,##0.0" ) & " ) = "
			        & FORMAT ( DIVIDE ( B, P ), "0.0%" )
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0009-4c30-9f03-cc3300000009

	/// VALIDACIÓN · Ventana efectiva de la rotación 12M móvil, ya recortada al último mes completo. Es el tramo que suman [Val · 12M Bajas] y los stocks 12M.
	measure 'Val · 12M Ventana' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR Fin = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			VAR Ini = EDATE ( Fin, -12 ) + 1
			RETURN
			    IF (
			        MIN ( 'Calendario'[Date] ) <= FinCerrado,
			        FORMAT ( Ini, "dd-mmm-yyyy" ) & " al " & FORMAT ( Fin, "dd-mmm-yyyy" )
			    )
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0010-4c30-9f03-cc3300000010

	/// VALIDACIÓN · Numerador de [Rotación % 12M Móvil]: bajas de los últimos 12 meses cerrados.
	measure 'Val · 12M Bajas' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR Fin = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			VAR Ini = EDATE ( Fin, -12 ) + 1
			RETURN
			    IF (
			        MIN ( 'Calendario'[Date] ) <= FinCerrado,
			        CALCULATE (
			            COUNTROWS ( 'Fact Movimientos' ),
			            'Fact Movimientos'[Tipo] = "Baja",
			            REMOVEFILTERS ( 'Calendario' ),
			            'Fact Movimientos'[Fecha] >= Ini,
			            'Fact Movimientos'[Fecha] <= Fin
			        ) + 0
			    )
		formatString: #,##0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0011-4c30-9f03-cc3300000011

	/// VALIDACIÓN · Stock de activos al día previo al arranque de la ventana 12M. Primer término del denominador de [Rotación % 12M Móvil].
	measure 'Val · 12M HC Inicio' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR Fin = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			VAR Ini = EDATE ( Fin, -12 ) + 1
			VAR D = Ini - 1
			RETURN
			    IF (
			        MIN ( 'Calendario'[Date] ) <= FinCerrado,
			        CALCULATE (
			            DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			            FILTER (
			                'Asignaciones',
			                'Asignaciones'[Enterprise Hire Date] <= D
			                    && (
			                        'Asignaciones'[Termination Date] > D
			                            || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                    )
			            )
			        )
			    )
		formatString: #,##0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0012-4c30-9f03-cc3300000012

	/// VALIDACIÓN · Stock de activos al cierre de la ventana 12M. Segundo término del denominador de [Rotación % 12M Móvil].
	measure 'Val · 12M HC Fin' =
			VAR FinCerrado = EOMONTH ( TODAY (), -1 )
			VAR Fin = MIN ( MAX ( 'Calendario'[Date] ), FinCerrado )
			RETURN
			    IF (
			        MIN ( 'Calendario'[Date] ) <= FinCerrado,
			        CALCULATE (
			            DISTINCTCOUNT ( 'Asignaciones'[Person Number] ),
			            FILTER (
			                'Asignaciones',
			                'Asignaciones'[Enterprise Hire Date] <= Fin
			                    && (
			                        'Asignaciones'[Termination Date] > Fin
			                            || 'Asignaciones'[Termination Date] = DATE ( 1900, 1, 1 )
			                    )
			            )
			        )
			    )
		formatString: #,##0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0013-4c30-9f03-cc3300000013

	/// VALIDACIÓN · Denominador de [Rotación % 12M Móvil]: promedio de los dos stocks de la ventana.
	measure 'Val · 12M HC Promedio' = DIVIDE ( [Val · 12M HC Inicio] + [Val · 12M HC Fin], 2 )
		formatString: #,##0.0
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0014-4c30-9f03-cc3300000014

	/// VALIDACIÓN · La cuenta de la rotación 12M móvil escrita con los números del contexto actual.
	measure 'Val · Fórmula 12M' =
			VAR B = [Val · 12M Bajas]
			VAR P = [Val · 12M HC Promedio]
			RETURN
			    IF (
			        NOT ISBLANK ( P ),
			        FORMAT ( B, "#,##0" ) & " bajas ÷ " & FORMAT ( P, "#,##0.0" ) & " = "
			            & FORMAT ( DIVIDE ( B, P ), "0.0%" ) & "   (ventana " & [Val · 12M Ventana] & ")"
			    )
		displayFolder: 09 · Validación Turnover
		lineageTag: 3d4e5f60-0015-4c30-9f03-cc3300000015

	/// Activos que participan del esquema MBO ([Esquema MBO] = "Con MBO").
	measure 'HC con MBO' = CALCULATE([HC Activo], 'Asignaciones'[Esquema MBO] = "Con MBO")
		formatString: #,##0
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0101-4d40-9004-dd4400000101

	/// Activos alcanzados por el esquema pero marcados explícitamente fuera de él ([Esquema MBO] = "Sin MBO"). No incluye a los "No Aplica".
	measure 'HC sin MBO' = CALCULATE([HC Activo], 'Asignaciones'[Esquema MBO] = "Sin MBO")
		formatString: #,##0
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0102-4d40-9004-dd4400000102

	/// Penetración del esquema MBO sobre TODO el headcount activo, incluidos los "No Aplica".
	measure '% HC con MBO' = DIVIDE([HC con MBO], [HC Activo])
		formatString: 0.0%
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0103-4d40-9004-dd4400000103

	/// Penetración del esquema MBO solo sobre la población que Oracle marca ("Con MBO" + "Sin MBO"), dejando fuera a los "No Aplica". Es la tasa dentro del universo alcanzado.
	measure '% MBO sobre Alcanzados' = DIVIDE([HC con MBO], [HC con MBO] + [HC sin MBO])
		formatString: 0.0%
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0104-4d40-9004-dd4400000104

	/// Activos elegibles para el canje de bonus ([Bonus Swap] = "Elegible").
	measure 'HC Elegible Bonus Swap' = CALCULATE([HC Activo], 'Asignaciones'[Bonus Swap] = "Elegible")
		formatString: #,##0
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0105-4d40-9004-dd4400000105

	/// Cuánto del universo MBO además puede canjear el bonus. El Bonus Swap es un subconjunto del MBO, por eso el denominador es [HC con MBO].
	measure '% Bonus Swap sobre MBO' = DIVIDE([HC Elegible Bonus Swap], [HC con MBO])
		formatString: 0.0%
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0106-4d40-9004-dd4400000106

	/// Grade más bajo que participa del esquema MBO en el contexto actual. Muestra dónde arranca de hecho el esquema. Descarta el sentinel 99 ("Sin Grade").
	measure 'Grade Mínimo con MBO' =
			CALCULATE (
			    MIN ( 'Asignaciones'[Grade Nº] ),
			    'Asignaciones'[Esquema MBO] = "Con MBO",
			    'Asignaciones'[Grade Nº] <> 99
			)
		formatString: 0
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0107-4d40-9004-dd4400000107

	/// Porcentaje de las MUJERES activas que participan del esquema MBO. Denominador: solo mujeres.
	measure '% con MBO · Femenino' =
			DIVIDE (
			    CALCULATE ( [HC con MBO], 'Dim Persona'[Género] = "Femenino" ),
			    CALCULATE ( [HC Activo], 'Dim Persona'[Género] = "Femenino" )
			)
		formatString: 0.0%
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0108-4d40-9004-dd4400000108

	/// Porcentaje de los VARONES activos que participan del esquema MBO. Denominador: solo varones.
	measure '% con MBO · Masculino' =
			DIVIDE (
			    CALCULATE ( [HC con MBO], 'Dim Persona'[Género] = "Masculino" ),
			    CALCULATE ( [HC Activo], 'Dim Persona'[Género] = "Masculino" )
			)
		formatString: 0.0%
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0109-4d40-9004-dd4400000109

	/// Brecha de acceso al MBO entre varones y mujeres, en PUNTOS PORCENTUALES. Positivo = los varones acceden más. Conviene leerla dentro de un mismo Grade: buena parte de la brecha total se explica por la composición por grade.
	measure 'Brecha MBO Género (pp)' = ( [% con MBO · Masculino] - [% con MBO · Femenino] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0110-4d40-9004-dd4400000110

	/// Bajas del período entre quienes hoy figuran con MBO. Recordar que el esquema es una foto actual: la persona pudo tener otro estado al momento de la baja.
	measure 'Bajas con MBO' = CALCULATE([Bajas], 'Asignaciones'[Esquema MBO] = "Con MBO")
		formatString: #,##0
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0111-4d40-9004-dd4400000111

	/// Rotación del período dentro de la población con MBO. Numerador y denominador se restringen al mismo segmento.
	measure 'Rotación % con MBO' =
			DIVIDE (
			    [Bajas con MBO],
			    CALCULATE ( [HC Activo Promedio], 'Asignaciones'[Esquema MBO] = "Con MBO" )
			)
		formatString: 0.0%
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0112-4d40-9004-dd4400000112

	/// Rotación del período en todo el resto de la dotación ("Sin MBO" + "No Aplica"). Es el término de comparación de [Rotación % con MBO].
	measure 'Rotación % sin MBO' =
			DIVIDE (
			    CALCULATE ( [Bajas], 'Asignaciones'[Esquema MBO] <> "Con MBO" ),
			    CALCULATE ( [HC Activo Promedio], 'Asignaciones'[Esquema MBO] <> "Con MBO" )
			)
		formatString: 0.0%
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0113-4d40-9004-dd4400000113

	/// Diferencia de rotación entre la población con MBO y el resto, en PUNTOS PORCENTUALES. Negativo = el segmento con MBO retiene mejor.
	measure 'Δ Rotación MBO (pp)' = ( [Rotación % con MBO] - [Rotación % sin MBO] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 12 · Compensación Variable
		lineageTag: 4e5f6071-0114-4d40-9004-dd4400000114

	/// VALIDACIÓN · Personas con más de una asignación cuyo [MBO Bonus Scheme] difiere entre filas. Debería ser 0; si no, el segmento MBO de esa persona depende de qué fila se lea.
	measure 'Val · MBO Inconsistente' =
			SUMX (
			    VALUES ( 'Asignaciones'[Person Number] ),
			    IF ( CALCULATE ( DISTINCTCOUNT ( 'Asignaciones'[MBO Bonus Scheme] ) ) > 1, 1 )
			)
		formatString: #,##0
		displayFolder: 08 · Validación (Data Quality)
		lineageTag: 4e5f6071-0115-4d40-9004-dd4400000115

