	/// Origen del valor de Cross Charge Entity Name: "Oracle", "Parche manual (Global Employees)" o "Sin Datos". Sirve para seguir qué personas aún dependen del parche hasta que se corrijan en Oracle.
	column 'Cross Charge Origen'
		dataType: string
		lineageTag: 8c1d4f7a-2e5b-4a93-b6d0-7f3e9a1c5b24
		summarizeBy: none
		sourceColumn: Cross Charge Origen

