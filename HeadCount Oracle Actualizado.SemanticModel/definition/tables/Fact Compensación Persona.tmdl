	partition 'Fact Compensación Persona' = m
		mode: import
		source =
				let
				    Base = #"Compensación Base",
				    Final = Table.SelectColumns(Base, {"Fecha Corte", "Person Number Resuelto", "Método Cruce", "Oracle ID", "ID Nacional", "País Origen", "Moneda", "Línea Compañía", "Seguro Salud", "Seguro Vida", "FTE", "ACT/OFF", "Cantidad de Salarios", "Origen Cantidad Salarios", "ID Nacional Discrepante", "Oracle ID Duplicado"})
				in
				    Final

	annotation PBI_ResultType = Table

