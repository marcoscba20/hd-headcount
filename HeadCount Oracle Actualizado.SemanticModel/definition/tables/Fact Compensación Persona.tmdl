		annotation SummarizationSetBy = Automatic

	/// Hoja TC del archivo (entidad legal o país); si falta, la columna del Excel y, si viene vacía o en 0, 'Dim País'[Sueldos Anuales]. Ver 'Origen Cantidad Salarios'.
	column 'Cantidad de Salarios'
		dataType: double
		formatString: 0.00
		lineageTag: 79bd01c2-c254-4b89-aebb-32e8b0bb0d67
		summarizeBy: none
		sourceColumn: Cantidad de Salarios

		annotation SummarizationSetBy = Automatic

	column 'ID Nacional Discrepante'
		dataType: boolean
		lineageTag: 12c03bbf-cb6b-41db-a242-9eddbd676856
		summarizeBy: none
		sourceColumn: ID Nacional Discrepante

		annotation SummarizationSetBy = Automatic

