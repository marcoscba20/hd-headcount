/// Fact a nivel persona x corte del archivo de salarios: FTE, cantidad de salarios, beneficios (indicadores Sí/No) y calidad del cruce con Oracle. Se filtra por las mismas dimensiones que 'Fact Compensación' (Dim Persona, Calendario, Dim País); no hay vínculo directo entre las dos facts. Fuente confidencial.
table 'Fact Compensación Persona'
	lineageTag: 18eea52a-5863-4434-9a47-75542a33ccb8

	/// Filas del archivo de salarios en el contexto (una por persona y corte).
	measure 'HC con Salario' = COUNTROWS ( 'Fact Compensación Persona' )
		formatString: #,##0
		displayFolder: 13 · Compensación (USD)
		lineageTag: dbe25a59-b02e-4eae-9023-6dc659656bf7

	measure '% con Seguro de Salud' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[Seguro Salud] = "Sí" ),
			    COUNTROWS ( 'Fact Compensación Persona' )
			)
		formatString: 0.0%
		displayFolder: 13 · Compensación (USD)
		lineageTag: 71cf0c71-3b60-4807-a5a0-1ecc7ae2d8bf

	measure '% con Seguro de Vida' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[Seguro Vida] = "Sí" ),
			    COUNTROWS ( 'Fact Compensación Persona' )
			)
		formatString: 0.0%
		displayFolder: 13 · Compensación (USD)
		lineageTag: 9adade05-95dd-4bfe-b95f-072c835aef0d

	measure '% con Línea Compañía' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[Línea Compañía] = "Sí" ),
			    COUNTROWS ( 'Fact Compensación Persona' )
			)
		formatString: 0.0%
		displayFolder: 13 · Compensación (USD)
		lineageTag: 30feabbe-5422-4ff7-8a22-2556e5e5f480

	/// Salarios que no cruzaron ni por Oracle ID ni por ID Nacional.
	measure 'Filas sin cruce' = CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[Método Cruce] = "Sin cruce" )
		formatString: #,##0
		displayFolder: 14 · Calidad Compensación
		lineageTag: b2d7702d-80c4-4b1c-9f95-5bd3546a79f0

	/// Filas rescatadas por el fallback (sin Oracle ID válido).
	measure 'Filas cruzadas por ID Nacional' = CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[Método Cruce] = "ID Nacional" )
		formatString: #,##0
		displayFolder: 14 · Calidad Compensación
		lineageTag: 2800a1ef-029d-4793-b085-cdc6bbffa19a

	/// Cruzaron por Oracle ID pero el ID Nacional difiere entre archivos.
	measure 'Cant ID Nacional discrepante' = CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[ID Nacional Discrepante] = TRUE () )
		formatString: #,##0
		displayFolder: 14 · Calidad Compensación
		lineageTag: 9947ab74-417c-440a-9799-d223a9569c3b

	/// Filas cuyo Oracle ID aparece más de una vez en el mismo corte.
	measure 'Cant Oracle ID duplicado' = CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[Oracle ID Duplicado] = TRUE () )
		formatString: #,##0
		displayFolder: 14 · Calidad Compensación
		lineageTag: e60d2b09-4ce4-4f5c-a44d-7bb857332200

	/// Filas con Cantidad de Salarios en 0 o vacía aun después del fallback (el anual queda en blanco).
	measure 'Sin Cantidad de Salarios' =
			COUNTROWS (
			    FILTER ( 'Fact Compensación Persona', 'Fact Compensación Persona'[Cantidad de Salarios] = 0 )
			)
		formatString: #,##0
		displayFolder: 14 · Calidad Compensación
		lineageTag: 97d07c06-0312-4292-9bf8-d9d927bc3476

	/// Personas activas en Oracle sin fila de salario en el corte seleccionado.
	measure 'Activos Oracle sin salario' =
			VAR Activos =
			    CALCULATETABLE (
			        VALUES ( 'Asignaciones'[Person Number] ),
			        'Asignaciones'[Assignment Status Code] = "ACTIVE_PROCESS"
			    )
			VAR ConSalario = VALUES ( 'Fact Compensación Persona'[Person Number Resuelto] )
			RETURN
			    COUNTROWS ( EXCEPT ( Activos, ConSalario ) )
		formatString: #,##0
		displayFolder: 14 · Calidad Compensación
		lineageTag: 0e3949f4-18df-4413-b258-3fe067b39462

	/// Filas con Cantidad de Salarios completada desde la tabla por país (ni la hoja TC ni el archivo la traen).
	measure 'Cantidad de Salarios por fallback' = CALCULATE ( COUNTROWS ( 'Fact Compensación Persona' ), 'Fact Compensación Persona'[Origen Cantidad Salarios] = "Tabla por país" )
		formatString: #,##0
		displayFolder: 14 · Calidad Compensación
		lineageTag: a2b42796-7d73-4f3a-9c31-9bdb2feb67d2

	column 'Fecha Corte'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 7c942ea4-5882-4c99-8830-a8018bfb470e
		summarizeBy: none
		sourceColumn: Fecha Corte

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Person Number Resuelto'
