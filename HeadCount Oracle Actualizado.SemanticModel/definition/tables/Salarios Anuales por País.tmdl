/// Tabla manual: cantidad de sueldos anuales por país según ley (ARG 12+SAC; BRA 12+13°+1/3 vacaciones; CHI 12; COL 12+prima; MXC 12+aguinaldo 15 días+prima vacacional; PER 12+2 gratificaciones; PAN 12+décimo tercer mes). AE (Area Expense) toma el país de empleo de Oracle. Fallback cuando el archivo de salarios trae Cantidad de Salarios vacía o en 0. Los valores se editan en la partición.
table 'Salarios Anuales por País'
	lineageTag: 88526892-7225-4d2f-ada3-2f70915d9d72

	/// Código de país del archivo de salarios (País Origen).
	column 'País Origen'
		dataType: string
		lineageTag: 9aec8d84-57f5-4ba1-b342-69babd3bb164
		summarizeBy: none
		sourceColumn: País Origen

		annotation SummarizationSetBy = Automatic

	column 'Sueldos Anuales'
		dataType: double
		formatString: 0.00
		lineageTag: ccf481d6-b5f7-4989-a2f6-1834e6020a78
		summarizeBy: none
		sourceColumn: Sueldos Anuales

		annotation SummarizationSetBy = Automatic

	partition 'Salarios Anuales por País' = m
		mode: import
		source =
				let
				    Origen = #table(type table [#"País Origen" = text, #"Sueldos Anuales" = number], {
				        {"ARG", 13},
				        {"BRA", 13.33},
				        {"CHI", 12},
				        {"COL", 13},
				        {"MXC", 12.6},
				        {"PER", 14},
				        {"PAN", 13}
				    })
				in
				    Origen

	annotation PBI_ResultType = Table

