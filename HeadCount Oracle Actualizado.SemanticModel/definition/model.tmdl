model Model
	culture: es-AR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SharePoint","Parche Cross Charge Global","Excel HC Oracle","HC Manual LATAM","Países","Salarios Anuales por País","Tipo de Cambio","Salarios Origen","Oracle Ordenado","Oracle Persona Unica","Compensación Base","Dim Persona","Dim Concepto Compensación","Fact Compensación","Compensación Atributos","fnNormId"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Excel HC Oracle'
ref table Calendario
ref table 'HC Manual LATAM'
ref table Países
ref table 'Dim Entidad Legal'
ref table 'Dim Centro de Costo'
ref table 'Dim Type'
ref table 'Calendario Ingreso'
ref table 'Calendario Baja'
ref table 'Movimiento HC'
ref table 'Desglose Turnover'
ref table 'People Excellence KPI'
ref table 'People Excellence Columna'
ref table 'Tipo de Cambio'
ref table 'Dim Persona'
ref table 'Dim Concepto Compensación'
ref table 'Fact Compensación'
ref table 'Compensación Atributos'
ref table 'Salarios Anuales por País'

ref cultureInfo es-AR

