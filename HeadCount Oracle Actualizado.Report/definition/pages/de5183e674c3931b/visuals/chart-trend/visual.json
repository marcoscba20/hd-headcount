{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "chart-trend",
  "position": {
    "x": 40,
    "y": 285,
    "z": 9000,
    "height": 360,
    "width": 900,
    "tabOrder": 9000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendario"
                    }
                  },
                  "Property": "Año-Mes"
                }
              },
              "queryRef": "Calendario.Año-Mes",
              "nativeQueryRef": "Año-Mes",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Asignaciones"
                    }
                  },
                  "Property": "Rotación %"
                }
              },
              "queryRef": "Asignaciones.Rotación %",
              "nativeQueryRef": "Rotación %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Asignaciones"
                    }
                  },
                  "Property": "Rotación Voluntaria %"
                }
              },
              "queryRef": "Asignaciones.Rotación Voluntaria %",
              "nativeQueryRef": "Rotación Voluntaria %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Asignaciones"
                    }
                  },
                  "Property": "Rotación Involuntaria %"
                }
              },
              "queryRef": "Asignaciones.Rotación Involuntaria %",
              "nativeQueryRef": "Rotación Involuntaria %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Asignaciones"
                    }
                  },
                  "Property": "Rotación % 12M Móvil"
                }
              },
              "queryRef": "Asignaciones.Rotación % 12M Móvil",
              "nativeQueryRef": "Rotación % 12M Móvil"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Calendario"
                  }
                },
                "Property": "Año-Mes"
              }
            },
            "direction": "Ascending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Evolución de la Rotación Mensual (con 12M móvil)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "15D"
                }
              }
            },
            "fontFamily": {
              "expr": {
                "Literal": {
                  "Value": "''Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "border": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#E6E6E6'"
                    }
                  }
                }
              }
            },
            "width": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            },
            "radius": {
              "expr": {
                "Literal": {
                  "Value": "8D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}